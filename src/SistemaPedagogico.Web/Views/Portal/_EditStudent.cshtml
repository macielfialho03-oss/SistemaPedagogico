@model Student
<form action="/portal/salvar?kind=student" method="post" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id"><label>Nome completo<input name="Name" data-fullname type="text" value="@Model.Name" required maxlength="120"></label><label>Nascimento<input name="BirthDate" type="date" max="@DateTime.Today.AddYears(-4).ToString("yyyy-MM-dd")" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))" ></label><label>E-mail<input name="Email" type="email" value="@Model.Email" ></label><label>Telefone<input name="Phone" type="tel" inputmode="tel" autocomplete="tel-national" data-phone placeholder="(69) 99999-9999" title="Informe o DDD e o número do telefone" value="@Model.Phone" ></label><label>Tipo de atendimento<select name="ServiceType" data-current="@Model.ServiceType" required><option>Reforço escolar</option><option>Acompanhamento escolar</option><option>Ambos</option></select></label><label>Nível escolar<select name="Level" data-current="@Model.Level" required><option value="Pré-escola">Pré-escola</option><option value="Ensino Fundamental I">Ensino Fundamental I</option><option value="Ensino Fundamental II">Ensino Fundamental II</option><option value="Ensino Médio">Ensino Médio</option><option value="Pré-vestibular">Pré-vestibular</option></select></label><label>Turno<select name="Shift" data-current="@Model.Shift" required><option value="Manhã">Manhã</option><option value="Tarde">Tarde</option><option value="Noite">Noite</option></select></label><label>Responsável<input name="Guardian" data-fullname type="text" value="@Model.Guardian" ></label><label>Telefone do responsável<input name="GuardianPhone" type="tel" inputmode="tel" autocomplete="tel-national" data-phone placeholder="(69) 99999-9999" title="Informe o DDD e o número do telefone" value="@Model.GuardianPhone" ></label><partial name="_SubjectChoices" model="Model.SubjectIds" /><label>Situação<select name="Status" data-current="@Model.Status" required><option value="Ativo">Ativo</option><option value="Inativo">Inativo</option><option value="Formado">Formado</option></select></label><div class="span2"><button class="btn primary">Salvar</button></div></form>