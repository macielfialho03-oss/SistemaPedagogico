@model PortalVm
@{var titles=new Dictionary<string,string>{{"painel",Model.Role=="Admin"?"Meu painel":"Olá, "+User.Identity?.Name+"! 👋"},{"alunos",Model.Role=="Professor"?"Meus alunos":"Alunos"},{"aulas",Model.Role=="Aluno"?"Minhas aulas":"Agenda de aulas"},{"materias","Matérias"},{"mensalidades","Controle de Mensalidades"},{"usuarios","Contas e Permissões"},{"notas",Model.Role=="Aluno"?"Minhas notas":"Notas e desempenho"},{"atividades",Model.Role=="Aluno"?"Minhas atividades":"Atividades"},{"atividade","Detalhes da atividade"},{"materiais","Materiais Didáticos"},{"progresso",Model.Role=="Aluno"?"Meu progresso":"Histórico de progresso"},{"relatorios","Relatórios"},{"backup","Backup"},{"ficha","Ficha do aluno"}};ViewData["Title"]=titles[Model.Section];}
@{var create=new Dictionary<string,(string id,string text)>{{"notas",("nova-nota","Lançar nota")},{"mensalidades",("nova-mensalidade","Nova mensalidade")},{"alunos",("cadastro-aluno","Novo aluno")},{"materias",("nova-materia","Nova matéria")},{"aulas",("nova-aula","Agendar aula")},{"atividades",("nova-atividade","Nova atividade")},{"materiais",("novo-material","Publicar material")},{"progresso",("novo-progresso","Registrar progresso")},{"usuarios",("novo-acesso","Criar acesso")}};}
<header class="page-head"><div><h1>@ViewData["Title"]</h1><p>@(Model.Section switch {"alunos"=>Model.Role=="Professor"?"Consulte os alunos que você acompanha.":"Organize as matrículas e os atendimentos.","aulas"=>Model.Role=="Aluno"?"Confira suas próximas aulas e horários.":"Organize a semana e registre a presença dos alunos.","notas"=>Model.Role=="Aluno"?"Confira suas avaliações e os comentários da professora.":"Registre avaliações e acompanhe a evolução dos seus alunos.","atividades"=>Model.Role=="Aluno"?"Confira suas tarefas, envie respostas e veja as correções.":"Crie atividades e acompanhe as entregas dos seus alunos.","materiais"=>Model.Role=="Aluno"?"Acesse seus materiais de estudo.":"Compartilhe materiais de estudo com seus alunos.","progresso"=>Model.Role=="Aluno"?"Acompanhe seus avanços e os próximos passos.":"Registre os avanços e planeje os próximos passos de cada aluno.","mensalidades"=>"Acompanhe vencimentos e registre pagamentos.","ficha"=>"Todos os registros deste aluno em um só lugar.","atividade"=>Model.Role=="Aluno"?"Consulte o enunciado, envie sua resposta e veja a correção.":"Acompanhe as entregas e corrija cada aluno em um só lugar.",_=>"Tutoring — Reforço e Acompanhamento Escolar"})</p></div><div class="actions">@if(create.TryGetValue(Model.Section,out var action)&&(Model.Role=="Admin"||Model.Role=="Professor"&&new[]{"notas","atividades","materiais","progresso"}.Contains(Model.Section))){<a class="btn primary" href="#@action.id">+ @action.text</a>}@if(Model.Role=="Admin"&&Model.Section!="mensalidades"&&Model.Section!="atividade"){<a class="btn subtle" href="/portal?section=mensalidades">Mensalidades</a>}</div></header>
<script type="application/json" id="portal-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {role=Model.Role,entity=Model.Entity,ownerTeacher=Model.OwnerTeacherId,students=Model.Students.Select(x=>new{id=x.Id,subjects=PortalRules.Ids(x.SubjectIds),service=x.ServiceType}),progress=Model.Progress.Select(x=>new{id=x.Id,student=x.StudentId,date=x.Date.ToString("dd/MM/yyyy"),evolution=x.Evolution,next=x.NextSteps}),teachers=Model.Teachers.Select(x=>new{id=x.Id,subjects=PortalRules.Ids(x.SubjectIds)}),enrollments=Model.Enrollments.Select(x=>new{student=x.StudentId,teacher=x.TeacherId})}))</script>

@if(Model.Section=="painel"){
<div class="metrics">
@if(Model.Role=="Admin"){
<div class="metric violet"><span>👥</span><strong>@Model.Students.Count(x=>x.Active)</strong><small>Alunos ativos</small><a href="/portal?section=alunos">Ver alunos →</a></div>
<div class="metric purple"><span>📝</span><strong>@Model.Activities.Count(x=>x.Status=="Entregue")</strong><small>Entregas para corrigir</small><a href="/portal?section=atividades">Ver atividades →</a></div>
<div class="metric blue"><span>📅</span><strong>@Model.Lessons.Where(x=>x.Start.Month==DateTime.Today.Month&&x.Start.Year==DateTime.Today.Year&&x.Status!="Cancelada").GroupBy(PortalRules.LessonGroup).Count()</strong><small>Aulas neste mês</small><a href="/portal?section=aulas">Abrir agenda →</a></div>
<div class="metric orange"><span>⚠️</span><strong>@Model.Payments.Count(x=>x.Paid==null)</strong><small>Mensalidades em aberto · @Model.Payments.Where(x=>x.Paid==null).Sum(x=>x.Amount).ToString("C")</small><a href="/portal?section=mensalidades">Ver registros →</a></div>
}else{
<div class="metric violet"><span>📊</span><strong>@(Model.Role=="Professor"?Model.Students.Count.ToString():Model.Grades.Count.ToString())</strong><small>@(Model.Role=="Professor"?"Alunos acompanhados":"Avaliações recebidas")</small><a href="/portal?section=notas">Ver notas →</a></div>
<div class="metric purple"><span>📅</span><strong>@Model.Lessons.Where(x=>x.Start.Month==DateTime.Today.Month&&x.Start.Year==DateTime.Today.Year&&x.Status!="Cancelada").GroupBy(PortalRules.LessonGroup).Count()</strong><small>Aulas neste mês</small><a href="/portal?section=aulas">Abrir agenda →</a></div>
<div class="metric blue"><span>📝</span><strong>@Model.Activities.Count(x=>Model.Role=="Professor"?x.Status=="Entregue":x.Status=="Pendente")</strong><small>@(Model.Role=="Professor"?"Entregas para corrigir":"Atividades pendentes")</small><a href="/portal?section=atividades">Ver atividades →</a></div>
<div class="metric orange"><span>✅</span><strong>@(Model.Lessons.Any(x=>x.Status=="Concluída")?(100.0*Model.Lessons.Count(x=>x.Attendance=="Presente")/Model.Lessons.Count(x=>x.Status=="Concluída")).ToString("0")+"%":"—")</strong><small>Presença nas aulas concluídas</small><a href="/portal?section=progresso">Ver progresso →</a></div>
}
</div>

@if(Model.Role=="Admin") { <div class="dashboard-grid"><section class="panel"><h2>Aulas de hoje</h2>@foreach(var todayGroup in Model.Lessons.Where(x=>x.Start.Date==DateTime.Today&&x.Status!="Cancelada").GroupBy(PortalRules.LessonGroup)){var l=todayGroup.First();<div class="list-item"><div><strong>@l.Start.ToString("HH:mm") · @(todayGroup.Count()==1?Model.StudentName(l.StudentId):todayGroup.Count()+" alunos")</strong><small>@Model.SubjectName(l.SubjectId)</small></div></div>}<a href="/portal?section=aulas">Abrir agenda →</a></section><section class="panel"><h2>Pendências para resolver</h2><div class="list-item"><strong>@Model.Payments.Count(x=>x.Paid==null&&x.Due.Date<DateTime.Today) mensalidades atrasadas</strong><a href="/portal?section=mensalidades">Ver →</a></div><div class="list-item"><strong>@Model.Activities.Count(x=>x.Status=="Entregue") entregas para corrigir</strong><a href="/portal?section=atividades">Ver →</a></div><div class="list-item"><strong>@Model.Lessons.Count(x=>x.Status=="Agendada"&&x.Start<DateTime.Now) presenças aguardando registro</strong><a href="/portal?section=aulas">Ver →</a></div></section></div> }
else {<div class="dashboard-grid"><section class="panel"><div class="panel-head"><h2>Próximas aulas</h2><a href="/portal?section=aulas">Ver agenda →</a></div>@foreach(var x in Model.Lessons.Where(x=>x.Start>=DateTime.Now&&x.Status=="Agendada").Take(5)){<div class="list-item"><span class="avatar">📅</span><div><strong>@Model.SubjectName(x.SubjectId)</strong><small>@Model.StudentName(x.StudentId)</small><small>@x.Start.ToString("dd/MM HH:mm") · @x.Mode</small></div></div>}@if(!Model.Lessons.Any(x=>x.Start>=DateTime.Now&&x.Status=="Agendada")){<p class="empty">Nenhuma aula próxima.</p>}</section>
<section class="panel"><div class="panel-head"><h2>Atividades</h2><a href="/portal?section=atividades">Ver todas →</a></div>@foreach(var x in Model.Activities.Where(x=>x.Status!="Corrigida").Take(5)){<div class="list-item"><span>📝</span><div><strong>@x.Title</strong><small>@Model.SubjectName(x.SubjectId) · @x.Due.ToString("dd/MM") · @x.Status</small></div></div>}@if(!Model.Activities.Any(x=>x.Status!="Corrigida")){<p class="empty">Nenhuma atividade pendente.</p>}</section>
<section class="panel"><h2>Desempenho por matéria</h2>@foreach(var g in Model.Grades.GroupBy(x=>new{x.SubjectId,x.Source})){var average=g.Average(x=>x.Value);<div class="grade-line"><span>@Model.SubjectName(g.Key.SubjectId)<small>@(g.Key.Source=="Nota da escola"?"Escola":"Professor")</small></span><meter min="0" max="10" value="@average.ToString(System.Globalization.CultureInfo.InvariantCulture)">@average</meter><strong>@average.ToString("0.0")</strong></div>}@if(Model.Grades.Count==0){<p class="empty">As notas aparecerão após o lançamento.</p>}</section>
<section class="panel"><h2>Materiais recentes</h2>@foreach(var x in Model.Materials.Take(4)){<div class="list-item"><div><strong>@x.Title</strong><small>@Model.SubjectName(x.SubjectId)</small></div><a class="btn subtle" href="/portal/arquivo/material/@x.Id">Baixar</a></div>}@if(Model.Materials.Count==0){<p class="empty">Nenhum material publicado.</p>}</section></div>}
}else{
@if((Model.Section=="alunos"||Model.Section=="materias")){<form class="search" method="get"><input type="hidden" name="section" value="@Model.Section"><input name="q" value="@Model.Query" placeholder="Buscar pelo nome..." aria-label="Buscar pelo nome"><button class="btn subtle">Buscar</button></form>}
<partial name="@("_"+Model.Section)" model="Model" />
}
