@model PortalVm
@{ViewData["PortalVm"]=Model;}
@if(Model.Role!="Aluno"){<details id="novo-progresso" class="panel editor"><summary>Registrar progresso</summary><partial name="_ProgressForm" model="new Progress()" /></details>}
<partial name="_Filters" model="Model" />
<div class="actions print-tools"><button type="button" class="btn subtle" data-print>Imprimir / salvar PDF</button><span class="help">@(Model.Role=="Aluno"?"O relatório respeita o período e a matéria selecionados.":"O relatório respeita os filtros e omite as anotações internas.")</span></div>
<div class="timeline progress-list">
@foreach(var x in Model.Progress){<article class="panel progress-entry record" data-record data-student="@x.StudentId" data-subject="@x.SubjectId" data-date="@x.Date.ToString("yyyy-MM-dd")" data-evolution="@x.Evolution" data-next="@x.NextSteps">
<div class="panel-head"><div><span class="badge">@x.ServiceType</span><h2>@(Model.Role=="Aluno"?Model.SubjectName(x.SubjectId):Model.StudentName(x.StudentId))</h2><p class="record-meta">@x.Date.ToString("dd/MM/yyyy") · @Model.TeacherName(x.TeacherId)@if(Model.Role!="Aluno"){<span> · @Model.SubjectName(x.SubjectId)</span>}</p></div></div>
<div class="progress-highlights"><section><h3>@(Model.Role=="Aluno"?"Meus avanços":"Evolução observada")</h3><p class="preserve">@(x.Evolution==""?"Consulte os detalhes deste registro.":x.Evolution)</p></section>@if(x.NextSteps!=""){<section><h3>Próximos objetivos</h3><p class="preserve">@x.NextSteps</p></section>}</div>
<details class="record-details"><summary>Ver detalhes</summary>
@if(x.Goal!=""){<h3>O que estamos aprendendo</h3><p class="preserve">@x.Goal</p>}
@if(x.Difficulty!=""){<h3>Pontos que precisam de apoio</h3><p class="preserve">@x.Difficulty</p>}
@if(x.Tasks!=""){<h3>Tarefas da escola</h3><p class="preserve">@x.Tasks</p>}
@if(x.Autonomy!=""){<h3>Autonomia</h3><p>@x.Autonomy</p>}
@if(x.Worked!=""){<h3>O que praticamos</h3><p class="preserve">@x.Worked</p>}
@if(x.Text!=""){<h3>Observações compartilhadas</h3><p class="preserve">@x.Text</p>}</details>
@if(Model.Role!="Aluno"&&x.InternalNotes!=""){<details class="internal-note"><summary>Anotações internas</summary><p class="preserve">@x.InternalNotes</p></details>}
@if(Model.Role=="Admin"||Model.Role=="Professor"&&x.TeacherId==Model.Entity){<details><summary>Editar registro</summary><partial name="_ProgressForm" model="x" /></details><details><summary class="danger">Excluir registro</summary><form action="/portal/salvar?kind=delete-progress" method="post">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="ConfirmDelete" type="hidden" value="true"><p>Excluir o registro de @x.Date.ToString("dd/MM/yyyy") de @Model.StudentName(x.StudentId)? Esta ação não pode ser desfeita.</p><button class="btn danger">Confirmar exclusão</button></form></details>}
</article>}
</div><div class="panel empty" data-no-results @(Model.Progress.Count>0?"hidden":"")>Ainda não há registros para este período. Os avanços aparecerão após o registro do professor.</div>
