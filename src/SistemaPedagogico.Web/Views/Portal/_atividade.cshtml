@model PortalVm
@{ViewData["PortalVm"]=Model;var activity=Model.Activities.Single(x=>x.Id==Model.SelectedActivity);var rows=Model.Activities.OrderBy(x=>x.Status=="Entregue"?0:x.Status=="Pendente"?1:2).ThenBy(x=>Model.StudentName(x.StudentId)).ToList();}
<a class="btn subtle back-link" href="/portal?section=atividades">← Voltar às atividades</a>
<section class="panel assignment-detail"><div class="panel-head"><div><span class="badge">@Model.SubjectName(activity.SubjectId)</span><h2>@activity.Title</h2><p class="record-meta">Prazo: @activity.Due.ToString("dd/MM/yyyy") · @activity.Origin</p></div>
@if(Model.Role!="Aluno"&&rows.All(x=>x.Submitted==null&&x.Status=="Pendente")){<details><summary>Editar enunciado</summary><partial name="_ActivityForm" model="activity" /></details>}</div>
@if(activity.Description!=""){<p class="preserve assignment-description">@activity.Description</p>}
@if(activity.AssignmentKey!=null){<div class="actions"><a class="btn subtle" href="/portal/arquivo/enunciado/@activity.Id">Baixar @activity.AssignmentName</a>@if(new[]{".pdf",".png",".jpg",".jpeg",".txt"}.Contains(System.IO.Path.GetExtension(activity.AssignmentName??"").ToLowerInvariant())){<a class="btn subtle" href="/portal/arquivo/enunciado/@activity.Id?preview=true" target="_blank" rel="noopener">Visualizar atividade</a>}</div>}</section>
@if(Model.Role!="Aluno"){
<div class="delivery-summary"><span><strong>@rows.Count</strong> Alunos</span><span><strong>@rows.Count(x=>x.Status=="Pendente")</strong> Pendentes</span><span><strong>@rows.Count(x=>x.Status=="Entregue")</strong> Para corrigir</span><span><strong>@rows.Count(x=>x.Status=="Corrigida")</strong> Corrigidas</span></div>
<h2>Entregas dos alunos</h2><div class="delivery-toolbar"><div data-filter-bar><label>Buscar aluno<input type="search" data-filter="text" placeholder="Nome do aluno"></label></div><div class="tabs" data-status-tabs><button type="button" class="btn primary" data-status="">Todos</button><button type="button" class="btn subtle" data-status="Pendente">Pendentes</button><button type="button" class="btn subtle" data-status="Entregue">Para corrigir</button><button type="button" class="btn subtle" data-status="Corrigida">Corrigidas</button></div></div><p class="help" data-filter-count aria-live="polite"></p>
@foreach(var x in rows){<article class="panel record delivery-row" data-record data-status="@x.Status" data-student="@x.StudentId"><div class="panel-head"><div class="delivery-person"><span class="avatar">@PortalVm.Initials(Model.StudentName(x.StudentId))</span><div><h3>@Model.StudentName(x.StudentId)</h3><span class="badge @(x.Status=="Corrigida"?"good":"")">@(x.Status=="Entregue"?"Entregue · para corrigir":x.Status)</span></div></div>
@if(x.Status=="Entregue"){<details><summary class="primary-action">Corrigir resposta</summary><form action="/portal/salvar?kind=review" method="post" class="form-grid">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="ReturnActivityId" type="hidden" value="@activity.Id"><div class="span2 correction-response"><h3>@Model.StudentName(x.StudentId)</h3><partial name="_ActivityResponse" model="x" /></div><label>Nota (0 a 10)<input name="Score" data-score inputmode="decimal" required placeholder="Ex.: 7,5"></label><label class="span2">Feedback<textarea name="Feedback" required maxlength="3000" rows="4" placeholder="Explique o que o aluno acertou e o que pode melhorar."></textarea></label><div class="span2 form-actions"><button class="btn primary">Salvar correção</button><button type="button" class="btn subtle" data-close-editor>Cancelar</button></div></form></details>}</div>
@if(x.Submitted!=null||x.Status=="Corrigida"){<details class="response-details"><summary>@(x.Status=="Corrigida"?"Ver resposta e correção":"Ver resposta enviada")</summary><partial name="_ActivityResponse" model="x" /></details>}else{<p class="help">Aguardando a entrega do aluno.</p>}</article>}
<div class="panel empty" data-no-results hidden>Nenhum aluno para o filtro selecionado.</div>
}else{
<section class="panel"><div class="panel-head"><h2>Minha entrega</h2><span class="badge @(activity.Status=="Corrigida"?"good":"")">@activity.Status</span></div><partial name="_ActivityResponse" model="activity" />
@if(activity.Status!="Corrigida"){
@if(activity.Due.Date<DateTime.Today){<p class="help">Você ainda pode enviar sua resposta. A entrega será identificada como após o prazo.</p>}
<details id="minha-resposta"><summary class="primary-action">@(activity.Submitted==null?"Enviar resposta":"Atualizar resposta")</summary><form action="/portal/salvar?kind=submit" method="post" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@activity.Id"><input name="ReturnActivityId" type="hidden" value="@activity.Id"><label class="span2">Resposta<textarea name="Answer" maxlength="5000" rows="5">@activity.Answer</textarea><small>Escreva sua resposta ou envie um arquivo.</small></label><label class="span2">Arquivo opcional<input name="attachment" type="file" accept="@AttachmentRules.Accept"><small>@AttachmentRules.Help</small>@if(activity.FileKey!=null){<small>Arquivo atual: @activity.FileName. Mantido se não escolher outro.</small>}</label><div class="span2 form-actions"><button class="btn primary">Entregar</button><button type="button" class="btn subtle" data-close-editor>Cancelar</button></div></form></details>}
</section>}
