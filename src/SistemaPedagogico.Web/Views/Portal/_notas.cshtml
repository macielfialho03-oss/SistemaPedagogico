@model PortalVm
@{ViewData["PortalVm"]=Model;}
@if(Model.Role!="Aluno"){<details id="nova-nota" class="panel editor"><summary>Lançar nota</summary><partial name="_GradeForm" model="new Grade()" /></details>}
<partial name="_Filters" model="Model" />
<div class="record-grid">
@foreach(var x in Model.Grades){<article class="panel record grade-card" data-record data-student="@x.StudentId" data-subject="@x.SubjectId" data-date="@x.Date.ToString("yyyy-MM-dd")">
<div class="panel-head"><div><span class="badge">@(x.Source=="Nota da escola"?"Nota da escola":"Avaliação do professor")</span><h2>@x.Title</h2></div><strong class="score">@x.Value.ToString("0.0")<small>de 10</small></strong></div>
<p class="record-meta">@Model.SubjectName(x.SubjectId) · @x.Date.ToString("dd/MM/yyyy")</p>@if(Model.Role!="Aluno"){<p>@Model.StudentName(x.StudentId)</p>}
@if(x.Comment!=""){<div class="answer"><strong>Comentário do professor</strong><p class="preserve">@x.Comment</p></div>}
@if(Model.Role=="Admin"||Model.Role=="Professor"&&x.TeacherId==Model.Entity){<details><summary>Editar nota</summary><partial name="_GradeForm" model="x" /></details><details><summary class="danger">Excluir nota</summary><form action="/portal/salvar?kind=delete-grade" method="post">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><p>Excluir a avaliação “@x.Title” de @Model.StudentName(x.StudentId)? Esta ação não pode ser desfeita.</p><input name="ConfirmDelete" type="hidden" value="true"><button class="btn danger">Confirmar exclusão</button></form></details>}
</article>}
</div><div class="panel empty" data-no-results @(Model.Grades.Count>0?"hidden":"")>Nenhuma avaliação neste período. As notas aparecerão após o lançamento pelo professor.</div>
