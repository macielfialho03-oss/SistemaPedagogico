@model PortalVm
@if(Model.Role!="Aluno"){<details class="panel editor"><summary>＋ Lançar nota</summary><form action="/portal/salvar?kind=grade" method="post" class="form-grid">@Html.AntiForgeryToken()<label>Aluno<select name="StudentId" required><option value="">Selecione...</option>@foreach(var p in Model.Students.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Matéria<select name="SubjectId" required><option value="">Selecione...</option>@foreach(var p in Model.Subjects.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Origem da nota<select name="Source"><option>Avaliação da professora</option><option>Nota da escola</option></select></label><label>Avaliação<input name="Title" type="text" value="" required ></label><label>Nota de 0 a 10<input name="Value" type="number" value="" required min="0" max="10" step="0.1"></label><label>Data<input name="Date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required ></label><label>Comentário<input name="Comment" type="text" value="" ></label><div class="span2"><button class="btn primary">Salvar</button></div></form></details>}<div class="table-wrap"><table><thead><tr><th>Aluno</th><th>Matéria</th><th>Avaliação</th><th>Nota</th><th>Data</th><th>Comentário</th></tr></thead><tbody>@foreach(var x in Model.Grades){<tr><td>@Model.StudentName(x.StudentId)</td><td>@Model.SubjectName(x.SubjectId)</td><td>@x.Title<small>@x.Source</small></td><td><strong>@x.Value.ToString("0.0")</strong></td><td>@x.Date.ToString("dd/MM/yyyy")</td><td>@x.Comment</td></tr>}@if(Model.Grades.Count==0){<tr><td colspan="6" class="empty">Nenhum registro encontrado.</td></tr>}</tbody></table></div>