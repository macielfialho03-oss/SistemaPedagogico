@model PortalVm
@{ViewData["PortalVm"]=Model;var groups=Model.Activities.GroupBy(PortalRules.ActivityGroup).OrderBy(g=>g.First().Due).ToList();}
@if(Model.Role!="Aluno"){<details id="nova-atividade" class="panel editor"><summary>Criar atividade</summary><partial name="_ActivityForm" model="new Activity()" /></details>}
<partial name="_Filters" model="Model" />
<div class="tabs" data-status-tabs><button type="button" class="btn primary" data-status="">Todas</button><button type="button" class="btn subtle" data-status="Pendente">Pendentes</button><button type="button" class="btn subtle" data-status="Entregue">@(Model.Role=="Aluno"?"Entregues":"Para corrigir")</button><button type="button" class="btn subtle" data-status="Corrigida">Corrigidas</button></div>
<div class="assignment-grid">
@foreach(var group in groups){var x=group.First();var pending=group.Count(a=>a.Status=="Pendente");var delivered=group.Count(a=>a.Status=="Entregue");var corrected=group.Count(a=>a.Status=="Corrigida");
<a class="panel record assignment-card" href="/portal?section=atividade&amp;activityId=@x.Id" data-record data-participants="@System.Text.Json.JsonSerializer.Serialize(group.Select(a=>new{student=a.StudentId,status=a.Status}))" data-subject="@x.SubjectId" data-date="@x.Due.ToString("yyyy-MM-dd")">
<div class="assignment-top"><span class="badge">@Model.SubjectName(x.SubjectId)</span>@if(pending>0&&x.Due.Date<DateTime.Today){<span class="badge bad">Prazo encerrado</span>}</div>
<h2>@x.Title</h2><p class="record-meta">Prazo: @x.Due.ToString("dd/MM/yyyy")@if(Model.Role!="Aluno"){<span> · @group.Count() alunos</span>}</p>
@if(Model.Role!="Aluno"){<div class="assignment-counts"><span><strong>@pending</strong> Pendentes</span><span><strong>@delivered</strong> Para corrigir</span><span><strong>@corrected</strong> Corrigidas</span></div>}
else{<span class="badge @(x.Status=="Corrigida"?"good":"")">@x.Status</span>}
<span class="card-open">@(Model.Role=="Aluno"?"Abrir atividade":"Ver entregas e correções") →</span></a>}
</div><div class="panel empty" data-no-results @(groups.Count>0?"hidden":"")>@(groups.Count==0?"Nenhuma atividade cadastrada.":"Nenhuma atividade para os filtros selecionados.")</div>
