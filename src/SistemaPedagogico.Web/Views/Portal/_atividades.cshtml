@model PortalVm
@if(Model.Role!="Aluno"){<details id="nova-atividade" class="panel editor"><summary>＋ Criar atividade</summary><form action="/portal/salvar?kind=activity" method="post" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<fieldset class="choice-field span2"><legend>1. Alunos que receberão a atividade</legend><small data-recipient-count>0 alunos selecionados</small><input type="search" data-choice-search placeholder="Buscar aluno pelo nome"><div class="choice-options">@foreach(var p in Model.Students.Where(p=>p.Active)){<label class="choice-option"><input type="checkbox" name="StudentIds" value="@p.Id">@p.Name</label>}</div><p class="help">Selecione um ou mais alunos. Serão mostradas as matérias em comum.</p></fieldset><h3 class="span2 form-section">2. Dados da atividade</h3><label>Matéria<select name="SubjectId" required><option value="">Selecione...</option>@foreach(var p in Model.Subjects.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Origem<select name="Origin"><option>Proposta da professora</option><option>Tarefa da escola</option></select></label><label>Título<input name="Title" type="text" value="" required ></label><label>Prazo<input name="Due" type="date" value="" required ></label><h3 class="span2 form-section">3. Enunciado e anexo</h3><label class="span2">Enunciado<textarea name="Description" maxlength="3000" rows="3"></textarea></label><label class="span2">Anexar atividade (opcional, até 10 MB)<input type="file" name="attachment" accept=".pdf,.docx,.xlsx,.pptx,.txt,.png,.jpg,.jpeg"></label><div class="span2"><button class="btn primary">Publicar atividade</button><button type="button" class="btn subtle" data-close-editor>Cancelar</button></div></form></details>}<partial name="_Filters" model="Model" /><div class="tabs" data-status-tabs><button type="button" class="btn primary" data-status="">Todas</button><button type="button" class="btn subtle" data-status="Pendente">Pendentes</button><button type="button" class="btn subtle" data-status="Entregue">Entregues</button><button type="button" class="btn subtle" data-status="Corrigida">Corrigidas</button></div><div class="panel empty" data-no-results hidden>Nenhuma atividade para os filtros selecionados.</div>@if(Model.Activities.Count==0){<div class="panel empty">Nenhuma atividade cadastrada.</div>}@foreach(var x in Model.Activities){<article class="panel record activity-card" data-record data-student="@x.StudentId" data-subject="@x.SubjectId" data-date="@x.Due.ToString("yyyy-MM-dd")" data-status="@x.Status"><div class="panel-head"><h2>@x.Title</h2><span class="badge @(x.Status=="Pendente"&&x.Due.Date<DateTime.Today?"bad":x.Status=="Corrigida"?"good":"")">@(x.Status=="Pendente"&&x.Due.Date<DateTime.Today?"Atrasada":x.Status)</span></div><p class="record-meta">@Model.SubjectName(x.SubjectId) · @Model.TeacherName(x.TeacherId)</p><p><strong>Prazo: @x.Due.ToString("dd/MM/yyyy")</strong>@if(Model.Role!="Aluno"){<span> · @Model.StudentName(x.StudentId)</span>}</p><span class="badge">@(x.Origin=="Proposta da professora"?"Proposta do professor":x.Origin)</span><p class="preserve">@x.Description</p>@if(x.AssignmentKey!=null){<a class="btn subtle" href="/portal/arquivo/enunciado/@x.Id">Baixar atividade</a><small>@x.AssignmentName</small>@if(new[]{".pdf",".png",".jpg",".jpeg",".txt"}.Contains(System.IO.Path.GetExtension(x.AssignmentName??"").ToLowerInvariant())){<a class="btn subtle" href="/portal/arquivo/enunciado/@x.Id?preview=true" target="_blank" rel="noopener">Visualizar</a>}}@if(x.Submitted!=null){<div class="answer"><strong>Resposta enviada · @x.Submitted.Value.ToString("dd/MM/yyyy HH:mm")</strong><p class="preserve">@x.Answer</p>@if(x.FileKey!=null){<a href="/portal/arquivo/atividade/@x.Id">Baixar @x.FileName</a>}</div>}@if(x.Score!=null){<p><strong>Nota: @x.Score.Value.ToString("0.0")</strong></p><p class="preserve">@x.Feedback</p>}@if(Model.Role=="Aluno"&&x.Status!="Corrigida"){@if(x.Due.Date<DateTime.Today){<p class="help">O prazo terminou, mas você ainda pode enviar a resposta. Ela será identificada como entregue após o prazo.</p>}<details><summary class="primary-action">@(x.Submitted==null?"Enviar resposta":"Atualizar resposta")</summary><form action="/portal/salvar?kind=submit" method="post" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><label class="span2">Resposta<textarea name="Answer" maxlength="5000" rows="4">@x.Answer</textarea><small>Escreva sua resposta ou envie um arquivo. O arquivo anterior é mantido se você não escolher outro.</small></label><label>Arquivo opcional (até 10 MB)<input name="attachment" type="file" value="" ></label><div class="span2"><button class="btn primary">Entregar</button></div></form></details>}@if(Model.Role!="Aluno"&&x.Status=="Entregue"){<details><summary>Corrigir atividade</summary><form action="/portal/salvar?kind=review" method="post" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><label>Nota<input name="Score" data-score inputmode="decimal" required placeholder="Ex.: 7,5"></label><label class="span2">Feedback<textarea name="Feedback" required maxlength="3000" rows="3"></textarea></label><div class="span2"><button class="btn primary">Salvar correção</button></div></form></details>}@if(Model.Role!="Aluno"&&x.Submitted==null){<details><summary>Editar atividade</summary><form action="/portal/salvar?kind=activity" method="post" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="StudentId" type="hidden" value="@x.StudentId"><label>Matéria<select name="SubjectId" data-current="@x.SubjectId" required>@foreach(var p in Model.Subjects.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Origem<select name="Origin" data-current="@x.Origin"><option>Proposta da professora</option><option>Tarefa da escola</option></select></label><label>Título<input name="Title" value="@x.Title" required maxlength="150"></label><label>Prazo<input name="Due" type="date" value="@x.Due.ToString("yyyy-MM-dd")" required></label><label class="span2">Enunciado<textarea name="Description" maxlength="3000">@x.Description</textarea></label><label>Substituir anexo (opcional)<input type="file" name="attachment" accept=".pdf,.docx,.xlsx,.pptx,.txt,.png,.jpg,.jpeg"></label><button class="btn primary">Salvar alterações</button></form></details>}</article>}