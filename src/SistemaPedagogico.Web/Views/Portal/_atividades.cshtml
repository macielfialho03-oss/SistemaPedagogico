@model PortalVm
@if(Model.Role!="Aluno"){<details id="nova-atividade" class="panel editor"><summary>＋ Criar atividade</summary><form action="/portal/salvar?kind=activity" method="post" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<fieldset class="choice-field span2"><legend>Alunos que receberão a atividade</legend><input type="search" data-choice-search placeholder="Buscar aluno pelo nome"><div class="choice-options">@foreach(var p in Model.Students.Where(p=>p.Active)){<label class="choice-option"><input type="checkbox" name="StudentIds" value="@p.Id">@p.Name</label>}</div><p class="help">Selecione um ou mais alunos. Serão mostradas as matérias em comum.</p></fieldset><label>Matéria<select name="SubjectId" required><option value="">Selecione...</option>@foreach(var p in Model.Subjects.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Origem<select name="Origin"><option>Proposta da professora</option><option>Tarefa da escola</option></select></label><label>Título<input name="Title" type="text" value="" required ></label><label>Prazo<input name="Due" type="date" value="" required ></label><label class="span2">Enunciado<textarea name="Description" maxlength="3000" rows="3"></textarea></label><label class="span2">Anexar atividade (opcional, até 10 MB)<input type="file" name="attachment" accept=".pdf,.docx,.xlsx,.pptx,.txt,.png,.jpg,.jpeg"></label><div class="span2"><button class="btn primary">Publicar atividade</button></div></form></details>}@if(Model.Activities.Count==0){<div class="panel empty">Nenhuma atividade cadastrada.</div>}@foreach(var x in Model.Activities){<article class="panel"><div class="panel-head"><h2>@x.Title</h2><span class="badge">@(x.Status=="Pendente"&&x.Due.Date<DateTime.Today?"Atrasada":x.Status)</span></div><p>@Model.StudentName(x.StudentId) · @Model.SubjectName(x.SubjectId) · prazo @x.Due.ToString("dd/MM/yyyy")</p><span class="badge">@x.Origin</span><p class="preserve">@x.Description</p>@if(x.AssignmentKey!=null){<a class="btn subtle" href="/portal/arquivo/enunciado/@x.Id">Baixar atividade · @x.AssignmentName</a>}@if(x.Submitted!=null){<div class="answer"><strong>Entrega · @x.Submitted.Value.ToString("dd/MM/yyyy HH:mm")</strong><p class="preserve">@x.Answer</p>@if(x.FileKey!=null){<a href="/portal/arquivo/atividade/@x.Id">Baixar @x.FileName</a>}</div>}@if(x.Score!=null){<p><strong>Nota: @x.Score.Value.ToString("0.0")</strong></p><p class="preserve">@x.Feedback</p>}@if(Model.Role=="Aluno"&&x.Status!="Corrigida"){<details><summary>Entregar / atualizar resposta</summary><form action="/portal/salvar?kind=submit" method="post" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><label class="span2">Resposta<textarea name="Answer" maxlength="3000" rows="3"></textarea></label><label>Arquivo opcional (até 10 MB)<input name="attachment" type="file" value="" ></label><div class="span2"><button class="btn primary">Entregar</button></div></form></details>}@if(Model.Role!="Aluno"&&x.Status=="Entregue"){<details><summary>Corrigir atividade</summary><form action="/portal/salvar?kind=review" method="post" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><label>Nota<input name="Score" type="number" value="" required min="0" max="10" step="0.1"></label><label class="span2">Feedback<textarea name="Feedback" required maxlength="3000" rows="3"></textarea></label><div class="span2"><button class="btn primary">Salvar correção</button></div></form></details>}@if(Model.Role!="Aluno"&&x.Submitted==null){<details><summary>Editar atividade</summary><form action="/portal/salvar?kind=activity" method="post" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="StudentId" type="hidden" value="@x.StudentId"><label>Matéria<select name="SubjectId" data-current="@x.SubjectId" required>@foreach(var p in Model.Subjects.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Origem<select name="Origin" data-current="@x.Origin"><option>Proposta da professora</option><option>Tarefa da escola</option></select></label><label>Título<input name="Title" value="@x.Title" required maxlength="150"></label><label>Prazo<input name="Due" type="date" value="@x.Due.ToString("yyyy-MM-dd")" required></label><label class="span2">Enunciado<textarea name="Description" maxlength="3000">@x.Description</textarea></label><label>Substituir anexo (opcional)<input type="file" name="attachment" accept=".pdf,.docx,.xlsx,.pptx,.txt,.png,.jpg,.jpeg"></label><button class="btn primary">Salvar alterações</button></form></details>}</article>}