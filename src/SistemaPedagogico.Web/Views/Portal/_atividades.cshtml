@model PortalVm
@{ViewData["PortalVm"]=Model;var groups=Model.Activities.GroupBy(PortalRules.ActivityGroup).OrderBy(g=>g.First().Due).ToList();}
@if(Model.Role!="Aluno"){<details id="nova-atividade" class="panel editor"><summary>Criar atividade</summary><partial name="_ActivityForm" model="new Activity()" /></details>}
<partial name="_Filters" model="Model" />
<div class="tabs" data-status-tabs><button type="button" class="btn primary" data-status="">Todas</button><button type="button" class="btn subtle" data-status="Pendente">Pendentes</button><button type="button" class="btn subtle" data-status="Entregue">@(Model.Role=="Aluno"?"Entregues":"Para corrigir")</button><button type="button" class="btn subtle" data-status="Corrigida">Corrigidas</button></div>
<div class="assignment-list panel">
@foreach(var group in groups){var x=group.First();var pending=group.Count(a=>a.Status=="Pendente");var delivered=group.Count(a=>a.Status=="Entregue");var corrected=group.Count(a=>a.Status=="Corrigida");
<article class="assignment-row record" data-record data-participants="@System.Text.Json.JsonSerializer.Serialize(group.Select(a=>new{student=a.StudentId,status=a.Status}))" data-subject="@x.SubjectId" data-date="@x.Due.ToString("yyyy-MM-dd")"><a class="assignment-row-main" href="/portal?section=atividade&amp;activityId=@x.Id"><span class="assignment-subject"><span class="badge">@Model.SubjectName(x.SubjectId)</span>@if(pending>0&&x.Due.Date<DateTime.Today){<span class="badge bad">Prazo encerrado</span>}</span><span class="assignment-title"><strong>@x.Title</strong><small>Prazo: @x.Due.ToString("dd/MM/yyyy")@if(Model.Role!="Aluno"){<span> · @group.Count() @(group.Count()==1?"aluno":"alunos")</span>}</small></span>@if(Model.Role!="Aluno"){<span class="assignment-compact-counts"><span><strong>@pending</strong> pendentes</span><span><strong>@delivered</strong> para corrigir</span><span><strong>@corrected</strong> corrigidas</span></span>}else{<span class="badge @(x.Status=="Corrigida"?"good":"")">@x.Status</span>}<span class="assignment-open">Abrir →</span></a>@if(Model.Role!="Aluno"&&group.All(a=>a.Submitted==null&&a.Status=="Pendente")){<details><summary class="danger">Excluir</summary><form action="/portal/salvar?kind=delete-activity" method="post" class="form-grid" data-confirm="Excluir esta atividade da área de todos os alunos?">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="ConfirmDelete" type="hidden" value="true"><p class="span2">A atividade será removida de @group.Count() aluno(s). Esta ação não pode ser desfeita.</p><div class="span2 form-actions"><button class="btn danger">Confirmar exclusão</button><button type="button" class="btn subtle" data-close-editor>Voltar</button></div></form></details>}</article>}
</div><div class="panel empty" data-no-results @(groups.Count>0?"hidden":"")>@(groups.Count==0?"Nenhuma atividade cadastrada.":"Nenhuma atividade para os filtros selecionados.")</div>
