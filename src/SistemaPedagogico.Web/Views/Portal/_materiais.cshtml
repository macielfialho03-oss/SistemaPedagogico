@model PortalVm
@if(Model.Role!="Aluno"){<details id="novo-material" class="panel editor"><summary>＋ Publicar material</summary><form action="/portal/salvar?kind=material" method="post" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<label>Aluno<select name="StudentId" required><option value="">Selecione...</option>@foreach(var p in Model.Students.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label>@if(Model.Role=="Admin"){<label>Professor<select name="TeacherId" required><option value="">Selecione...</option>@foreach(var p in Model.Teachers.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label>}<label>Matéria<select name="SubjectId" required><option value="">Selecione...</option>@foreach(var p in Model.Subjects.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Título<input name="Title" type="text" value="" required ></label><label>Arquivo (até 10 MB)<input name="attachment" type="file" value="" required accept=".pdf,.docx,.xlsx,.pptx,.txt,.png,.jpg,.jpeg"></label><div class="span2"><button class="btn primary">Publicar material</button><button type="button" class="btn subtle" data-close-editor>Cancelar</button></div></form></details>}<partial name="_Filters" model="Model" /><div class="record-grid">
@foreach(var x in Model.Materials){<article class="panel record material-card" data-record data-student="@x.StudentId" data-subject="@x.SubjectId" data-date="@x.Created.ToString("yyyy-MM-dd")"><span class="file-icon">@System.IO.Path.GetExtension(x.FileName).TrimStart('.').ToUpperInvariant()</span><h2>@x.Title</h2><p class="record-meta">@Model.SubjectName(x.SubjectId) · @Model.TeacherName(x.TeacherId)</p>@if(Model.Role!="Aluno"){<p>Para @Model.StudentName(x.StudentId)</p>}<small>Publicado em @x.Created.ToString("dd/MM/yyyy")</small><p class="filename">@x.FileName</p><div class="actions">@if(new[]{".pdf",".png",".jpg",".jpeg",".txt"}.Contains(System.IO.Path.GetExtension(x.FileName).ToLowerInvariant())){<a class="btn subtle" href="/portal/arquivo/material/@x.Id?preview=true" target="_blank" rel="noopener">Visualizar</a>}<a class="btn primary" href="/portal/arquivo/material/@x.Id">Baixar material</a></div></article>}
</div><div class="panel empty" data-no-results @(Model.Materials.Count>0?"hidden":"")><h2>@(Model.Role=="Aluno"?"Seus materiais aparecerão aqui":"Você ainda não publicou materiais")</h2><p>@(Model.Role=="Aluno"?"Quando o professor compartilhar um material, você poderá acessá-lo nesta tela.":"Compartilhe o primeiro arquivo de estudo com seus alunos.")</p>@if(Model.Role!="Aluno"){<a class="btn primary" href="#novo-material">Publicar material</a>}</div>
