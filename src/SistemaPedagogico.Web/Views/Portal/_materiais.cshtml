@model PortalVm
@if(Model.Role!="Aluno"){<details id="novo-material" class="panel editor"><summary>＋ Publicar material</summary><form action="/portal/salvar?kind=material" method="post" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<label>Aluno<select name="StudentId" required><option value="">Selecione...</option><option value="0">Geral — todos os alunos</option>@foreach(var p in Model.Students.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Matéria<select name="SubjectId" required><option value="">Selecione...</option><option value="0">Todas as matérias</option>@foreach(var p in Model.Subjects.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Título<input name="Title" type="text" value="" required ></label><label>Arquivo (até 4 MB)<input name="attachment" type="file" value="" required accept="@AttachmentRules.Accept"><small>@AttachmentRules.Help</small></label><p class="help span2">Escolha “Geral” para disponibilizar o arquivo a todos os alunos e “Todas as matérias” quando o conteúdo não pertencer a uma matéria específica.</p><div class="span2"><button class="btn primary">Publicar material</button><button type="button" class="btn subtle" data-close-editor>Cancelar</button></div></form></details>}<partial name="_Filters" model="Model" /><div class="record-grid">
@foreach(var x in Model.Materials){<article class="panel record material-card" data-record data-student="@(x.StudentId>0?x.StudentId:"")" data-students="@(x.StudentId==0?string.Join(",",Model.Students.Select(s=>s.Id)):"")" data-subject="@(x.SubjectId>0?x.SubjectId:"")" data-subjects="@(x.SubjectId==0?string.Join(",",Model.Subjects.Where(s=>s.Active).Select(s=>s.Id)):"")" data-date="@x.Created.ToString("yyyy-MM-dd")"><span class="file-icon">@System.IO.Path.GetExtension(x.FileName).TrimStart('.').ToUpperInvariant()</span><h2>@x.Title</h2><p class="record-meta">@(x.SubjectId==0?"Todas as matérias":Model.SubjectName(x.SubjectId))</p>@if(Model.Role!="Aluno"){<p>Para @(x.StudentId==0?"todos os alunos":Model.StudentName(x.StudentId))</p>}<small>Publicado em @x.Created.ToString("dd/MM/yyyy")</small><p class="filename">@x.FileName</p><div class="actions">@if(new[]{".pdf",".png",".jpg",".jpeg",".txt"}.Contains(System.IO.Path.GetExtension(x.FileName).ToLowerInvariant())){<a class="btn subtle" href="/portal/arquivo/material/@x.Id?preview=true" target="_blank" rel="noopener">Visualizar</a>}<a class="btn primary" href="/portal/arquivo/material/@x.Id">Baixar material</a>@if(Model.Role!="Aluno"){<details><summary class="danger">Excluir material</summary><form action="/portal/salvar?kind=delete-material" method="post" class="form-grid" data-confirm="Excluir este material da área dos alunos?">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="ConfirmDelete" type="hidden" value="true"><p class="span2">O arquivo deixará de aparecer para @(x.StudentId==0?"todos os alunos":Model.StudentName(x.StudentId)).</p><div class="span2 form-actions"><button class="btn danger">Confirmar exclusão</button><button type="button" class="btn subtle" data-close-editor>Voltar</button></div></form></details>}</div></article>}
</div><div class="panel empty" data-no-results @(Model.Materials.Count>0?"hidden":"")><h2>@(Model.Role=="Aluno"?"Seus materiais aparecerão aqui":"Você ainda não publicou materiais")</h2><p>@(Model.Role=="Aluno"?"Quando a professora compartilhar um material, você poderá acessá-lo nesta tela.":"Compartilhe o primeiro arquivo de estudo com seus alunos.")</p>@if(Model.Role!="Aluno"){<a class="btn primary" href="#novo-material">Publicar material</a>}</div>
