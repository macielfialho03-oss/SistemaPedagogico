@model PortalVm
@if(Model.Role!="Aluno"){<details id="novo-material" class="panel editor"><summary>＋ Publicar material</summary><form action="/portal/salvar?kind=material" method="post" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<label>Aluno<select name="StudentId" required><option value="">Selecione...</option>@foreach(var p in Model.Students.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label>@if(Model.Role=="Admin"){<label>Professor<select name="TeacherId" required><option value="">Selecione...</option>@foreach(var p in Model.Teachers.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label>}<label>Matéria<select name="SubjectId" required><option value="">Selecione...</option>@foreach(var p in Model.Subjects.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Título<input name="Title" type="text" value="" required ></label><label>Arquivo (até 10 MB)<input name="attachment" type="file" value="" required accept=".pdf,.docx,.xlsx,.pptx,.txt,.png,.jpg,.jpeg"></label><div class="span2"><button class="btn primary">Publicar material</button></div></form></details>}<div class="table-wrap"><table><thead><tr><th>Material</th><th>Matéria</th><th>Aluno</th><th>Professor</th><th>Publicado</th><th>Download</th></tr></thead><tbody>@foreach(var x in Model.Materials){<tr><td><span class="badge">@System.IO.Path.GetExtension(x.FileName).TrimStart('.').ToUpperInvariant()</span> @x.Title<small>@x.FileName</small></td><td>@Model.SubjectName(x.SubjectId)</td><td>@Model.StudentName(x.StudentId)</td><td>@Model.TeacherName(x.TeacherId)</td><td>@x.Created.ToString("dd/MM/yyyy")</td><td><a class="btn subtle" href="/portal/arquivo/material/@x.Id">Baixar</a></td></tr>}@if(Model.Materials.Count==0){<tr><td colspan="6" class="empty">Nenhum registro encontrado.</td></tr>}</tbody></table></div>