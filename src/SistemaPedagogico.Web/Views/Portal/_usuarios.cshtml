@using System.Security.Claims
@model PortalVm
@{ViewData["PortalVm"]=Model;var newUser=new PortalUser();var staff=Model.Users.Where(x=>x.Role!="Aluno").ToList();var students=Model.Users.Where(x=>x.Role=="Aluno").ToList();var currentUserId=User.FindFirstValue(ClaimTypes.NameIdentifier);}
<p class="help">Crie acessos separados para administradores, professores e alunos. Cada perfil recebe somente as permissões correspondentes.</p>
<details id="novo-acesso" class="panel editor"><summary>＋ Criar novo acesso</summary><partial name="_UserForm" model="newUser" /></details>

<div class="access-groups">
<section class="access-group staff-access">
<div class="access-heading"><div><span class="eyebrow">EQUIPE PEDAGÓGICA</span><h2>Administradores e professores</h2><p>Administradores gerenciam todo o sistema. Professores acessam somente os alunos vinculados.</p></div><span class="access-count">@staff.Count conta@(staff.Count==1?"":"s")</span></div>
<div class="table-wrap"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Cadastro vinculado</th><th>Situação</th><th>Ações</th></tr></thead><tbody>
@foreach(var x in staff){var self=x.Id.ToString()==currentUserId;<tr><td><span class="avatar">@PortalVm.Initials(x.Name)</span> @x.Name</td><td>@x.Email</td><td>@(x.Role=="Admin"?"Administrador":"Professor")</td><td>@(x.Role=="Professor"?Model.TeacherName(x.EntityId):"Acesso administrativo")</td><td><span class="badge @(x.Active?"good":"bad")">@(x.Active?"Ativo":"Inativo")</span></td><td class="row-actions"><details><summary>Editar acesso</summary><partial name="_UserForm" model="x" /></details><details><summary>@(self?"Alterar minha senha":"Redefinir senha")</summary><form action="/portal/salvar?kind=user-password" method="post" class="form-grid">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id">@if(self){<label class="span2">Senha atual<input name="CurrentPassword" type="password" required autocomplete="current-password"></label>}<label class="span2">Nova senha<input name="Password" type="password" required minlength="10" autocomplete="new-password"></label><button class="btn primary">@(self?"Alterar senha":"Redefinir senha")</button></form></details>@if(!self){<form action="/portal/salvar?kind=user-status" method="post" data-confirm="@(x.Active?"Desativar o acesso de "+x.Name+"?":"Ativar o acesso de "+x.Name+"?")">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="Active" type="hidden" value="@(!x.Active?"true":"false")"><button class="btn subtle">@(x.Active?"Desativar acesso":"Ativar acesso")</button></form>}</td></tr>}
@if(staff.Count==0){<tr><td colspan="6" class="empty">Nenhum acesso da equipe foi configurado.</td></tr>}
</tbody></table></div>
</section>

<section class="access-group student-access">
<div class="access-heading"><div><span class="eyebrow">ACESSO INDIVIDUAL</span><h2>Alunos</h2><p>Cada aluno acessa apenas suas aulas, notas, atividades e evolução.</p></div><span class="access-count">@students.Count conta@(students.Count==1?"":"s")</span></div>
<div class="table-wrap"><table><thead><tr><th>Aluno</th><th>E-mail</th><th>Cadastro vinculado</th><th>Situação</th><th>Ações</th></tr></thead><tbody>
@foreach(var x in students){<tr><td><span class="avatar">@PortalVm.Initials(x.Name)</span> @x.Name</td><td>@x.Email</td><td>@Model.StudentName(x.EntityId??0)</td><td><span class="badge @(x.Active?"good":"bad")">@(x.Active?"Ativo":"Inativo")</span></td><td class="row-actions"><details><summary>Editar acesso</summary><partial name="_UserForm" model="x" /></details><details><summary>Redefinir senha</summary><form action="/portal/salvar?kind=user-password" method="post" class="form-grid">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><label class="span2">Nova senha para @x.Name<input name="Password" type="password" required minlength="10" autocomplete="new-password"></label><button class="btn primary">Redefinir senha</button></form></details><form action="/portal/salvar?kind=user-status" method="post" data-confirm="@(x.Active?"Desativar o acesso de "+x.Name+"?":"Ativar o acesso de "+x.Name+"?")">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="Active" type="hidden" value="@(!x.Active?"true":"false")"><button class="btn subtle">@(x.Active?"Desativar acesso":"Ativar acesso")</button></form></td></tr>}
@if(students.Count==0){<tr><td colspan="5" class="empty">Nenhum aluno possui acesso ainda. Use “Criar novo acesso” para começar.</td></tr>}
</tbody></table></div>
</section>
</div>
