@model PortalVm
@{ViewData["PortalVm"]=Model;var newUser=new PortalUser();}
<p class="help">Selecione um cadastro para preencher nome e e-mail. Cada aluno pode ter uma conta. Sua conta de professora reúne todas as funções de gestão.</p>
<details id="novo-acesso" class="panel editor"><summary>＋ Criar acesso</summary><partial name="_UserForm" model="newUser" /></details>
<div class="table-wrap"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Cadastro vinculado</th><th>Situação</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model.Users){<tr><td>@x.Name</td><td>@x.Email</td><td>@(x.Role=="Admin"?"Professora":"Aluno")</td><td>@(x.Role=="Aluno"?Model.StudentName(x.EntityId??0):x.Role=="Professor"?Model.TeacherName(x.EntityId):"Sua conta")</td><td>@(x.Active?"Ativo":"Inativo")</td><td><details><summary>Editar acesso</summary><partial name="_UserForm" model="x" /></details>
<details><summary>Redefinir senha</summary><form action="/portal/salvar?kind=user-password" method="post" class="form-grid">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><label class="span2">Nova senha para @x.Name<input name="Password" type="password" required minlength="10" autocomplete="new-password"></label><button class="btn primary">Redefinir senha</button></form></details>
@if(x.Role=="Aluno"){<form action="/portal/salvar?kind=user-status" method="post" data-confirm="@(x.Active?"Desativar o acesso de "+x.Name+"?":"Ativar o acesso de "+x.Name+"?")">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="Active" type="hidden" value="@(!x.Active?"true":"false")"><button class="btn subtle">@(x.Active?"Desativar acesso":"Ativar acesso")</button></form>}</td></tr>}</tbody></table></div>
