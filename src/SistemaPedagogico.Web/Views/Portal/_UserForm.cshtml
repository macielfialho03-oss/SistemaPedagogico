@model PortalUser
@{var vm=(PortalVm)ViewData["PortalVm"]!;}
<form action="/portal/salvar?kind=user" method="post" class="form-grid" data-user>@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@Model.Id">
<label>Tipo de acesso<select name="Role" data-current="@Model.Role" required><option value="Aluno">Aluno</option><option value="Professor">Professor</option><option value="Admin">Administrador</option></select></label>
<p class="help span2" data-account-help></p>
<label data-account-entity>Cadastro vinculado<select name="EntityId" data-current="@Model.EntityId"><option value="">Selecione pelo nome...</option>@foreach(var p in vm.Students.Where(x=>x.Active)){<option data-role="Aluno" data-email="@p.Email" value="@p.Id">@p.Name</option>}@foreach(var p in vm.Teachers.Where(x=>x.Active)){<option data-role="Professor" data-email="@p.Email" value="@p.Id">@p.Name</option>}</select><small data-entity-help></small></label>
<label>Nome completo<input name="Name" data-fullname value="@Model.Name" required maxlength="120"></label>
<label>E-mail de acesso<input name="Email" type="email" value="@Model.Email" required maxlength="150"></label>
<fieldset class="choice-field span2" data-teacher-students><legend>Alunos acompanhados pelo professor</legend><div class="choice-options">@foreach(var p in vm.Students.Where(p=>p.Active)){<label class="choice-option"><input type="checkbox" name="TeacherStudentIds" value="@p.Id" checked="@(Model.Role=="Professor"&&Model.EntityId.HasValue&&vm.Enrollments.Any(x=>x.TeacherId==Model.EntityId&&x.StudentId==p.Id))">@p.Name</label>}</div><p class="help">Marque somente os alunos que este professor poderá consultar e atender.</p></fieldset>
@if(Model.Id==0){<label class="span2">Senha (mínimo 10 caracteres)<input name="Password" type="password" minlength="10" maxlength="256" autocomplete="new-password" required><span class="actions"><button type="button" class="btn subtle" data-show-password>Mostrar senha</button><button type="button" class="btn subtle" data-generate-password>Gerar senha</button></span></label>}
<label>Situação<select name="Active" data-current="@Model.Active.ToString().ToLowerInvariant()"><option value="true">Ativo</option><option value="false">Inativo</option></select></label><div class="span2"><button class="btn primary">@(Model.Id==0?"Criar acesso":"Salvar acesso")</button></div></form>
