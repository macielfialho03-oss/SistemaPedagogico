@model Lesson
@{var vm=(PortalVm)ViewData["PortalVm"]!;var participants=Model.Id==0?new List<Lesson>():vm.Lessons.Where(x=>PortalRules.LessonGroup(x)==PortalRules.LessonGroup(Model)).ToList();}
<form action="/portal/salvar?kind=lesson" method="post" class="form-grid" data-lesson>@Html.AntiForgeryToken()
<input type="hidden" name="Id" value="@Model.Id">
@if(Model.Id==0){
<fieldset class="span2 choice-field"><legend>1. Quem participa?</legend><label class="choice-option"><input type="radio" name="RecipientMode" value="subject" checked> Todos os alunos ativos da matéria</label><label class="choice-option"><input type="radio" name="RecipientMode" value="manual"> Selecionar alunos manualmente</label><p class="help">Os alunos da matéria serão incluídos quando você salvar. Cadastros feitos depois não entram nas aulas já agendadas.</p></fieldset>
<fieldset class="choice-field span2" data-manual-recipients hidden><legend>Alunos selecionados</legend><small data-recipient-count>0 alunos selecionados</small><input type="search" data-choice-search placeholder="Buscar aluno pelo nome" aria-label="Buscar participante"><div class="choice-options">
@foreach(var p in vm.Students.Where(x=>x.Active)){<label class="choice-option"><input type="checkbox" name="StudentIds" value="@p.Id">@p.Name</label>}
</div><p class="help">No modo manual, marque um ou vários alunos que estudam a matéria escolhida.</p></fieldset>
}else{<div class="span2 answer"><strong>Participantes desta aula</strong><p>@string.Join(", ",participants.Select(x=>vm.StudentName(x.StudentId)))</p><small>A remarcação vale para todo o grupo. Participações canceladas não serão reativadas.</small></div>@foreach(var row in participants.Where(x=>x.Status=="Agendada")){<input name="StudentIds" type="hidden" value="@row.StudentId">}}
<h3 class="span2 form-section">@(Model.Id==0?"2. Data e horário":"Novo horário")</h3>
<label>Matéria<select name="SubjectId" data-current="@(Model.SubjectId==0?"":Model.SubjectId.ToString())" required><option value="">Selecione...</option>@foreach(var p in vm.Subjects.Where(x=>x.Active)){<option value="@p.Id">@p.Name</option>}</select></label>
<label>Duração<select name="Minutes" data-current="@Model.Minutes" required><option value="30">30 minutos</option><option value="60">1 hora</option><option value="90">1 hora e meia</option><option value="120">2 horas</option></select></label>
<label>Dia da aula<input name="LessonDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(Model.Id==0?"":Model.Start.ToString("yyyy-MM-dd"))" required></label>
<label>Hora de início<input name="LessonTime" type="time" value="@(Model.Id==0?"":Model.Start.ToString("HH:mm"))" required><small data-slots-note>Escolha a hora. O sistema verifica conflitos ao salvar.</small></label>
@if(Model.Id==0){<label class="span2">Agendamento automático semanal<input name="RepeatCount" type="number" min="1" max="52" value="1" required><small>Use 1 para uma única aula. Para repetir toda semana, informe a quantidade total de aulas (até 52).</small></label>}
<input type="hidden" name="Start" value="@(Model.Id==0?"":Model.Start.ToString("yyyy-MM-ddTHH:mm"))">
<label>Modalidade<select name="Mode" data-current="@Model.Mode" required><option>Presencial</option><option>Online</option></select></label>
<label data-online>Link da aula<input name="OnlineUrl" type="url" value="@Model.OnlineUrl" placeholder="https://..."></label>
<label class="span2">Observações<textarea name="Notes" maxlength="1000">@Model.Notes</textarea></label>
<div class="span2 form-actions"><button class="btn primary">@(Model.Id==0?"Agendar aula":"Remarcar aula para todos")</button><button type="button" class="btn subtle" data-close-editor>Cancelar</button></div></form>
