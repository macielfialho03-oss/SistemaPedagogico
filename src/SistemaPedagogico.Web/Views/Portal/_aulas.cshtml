@model PortalVm
@{ViewData["PortalVm"]=Model;var week=DateTime.TryParse(Context.Request.Query["week"],out var chosen)?chosen.Date:DateTime.Today;week=week.AddDays(-(((int)week.DayOfWeek+6)%7));var history=Context.Request.Query["view"]=="history";var next=Model.Lessons.FirstOrDefault(x=>x.Start>=DateTime.Now&&x.Status=="Agendada");}
<details id="nova-aula" class="panel editor"><summary>Agendar aula</summary><partial name="_LessonForm" model="new Lesson()" /></details>
@if(Model.Role=="Aluno"&&next!=null){<section class="panel next-lesson"><span class="badge">Sua próxima aula</span><h2>@Model.SubjectName(next.SubjectId)</h2><p><strong>@next.Start.ToString("dd/MM/yyyy 'às' HH:mm")</strong> · @Model.TeacherName(next.TeacherId) · @next.Mode</p>@if(next.Mode=="Online"&&next.OnlineUrl!=""){<a class="btn primary" href="@next.OnlineUrl" target="_blank" rel="noopener">Entrar na aula</a>}</section>}
<div class="tabs"><a class="btn @(history?"subtle":"primary")" href="/portal?section=aulas">@(Model.Role=="Aluno"?"Próximas aulas":"Semana")</a><a class="btn @(history?"primary":"subtle")" href="/portal?section=aulas&amp;view=history">Histórico</a></div>
@if(!history&&Model.Role!="Aluno"){<div class="week-nav"><a class="btn subtle" href="/portal?section=aulas&amp;week=@week.AddDays(-7).ToString("yyyy-MM-dd")">← Semana anterior</a><strong>@week.ToString("dd/MM") a @week.AddDays(6).ToString("dd/MM/yyyy")</strong><a class="btn subtle" href="/portal?section=aulas&amp;week=@week.AddDays(7).ToString("yyyy-MM-dd")">Próxima semana →</a></div>}
@{var rows=Model.Lessons.Where(x=>history?x.Start<DateTime.Now||x.Status!="Agendada":Model.Role=="Aluno"?x.Start>=DateTime.Now&&x.Status=="Agendada":x.Start>=week&&x.Start<week.AddDays(7)).ToList();}
@if(Model.Role!="Aluno"){<partial name="_Filters" model="Model" />}
<div class="lesson-list">
@foreach(var day in rows.GroupBy(x=>x.Start.Date)){<section class="day-group"><h2>@day.Key.ToString("dddd, dd/MM")</h2>@foreach(var x in day){<article class="panel record lesson-card" data-record data-student="@x.StudentId" data-subject="@x.SubjectId" data-date="@x.Start.ToString("yyyy-MM-dd")"><div class="lesson-time"><strong>@x.Start.ToString("HH:mm")</strong><small>@x.Minutes min</small></div><div class="lesson-body"><h3>@Model.SubjectName(x.SubjectId)</h3><p>@if(Model.Role!="Aluno"){<span>@Model.StudentName(x.StudentId) · </span>}@Model.TeacherName(x.TeacherId)</p><span class="badge">@x.Mode</span><span class="badge @(x.Status=="Cancelada"?"bad":x.Status=="Concluída"?"good":"")">@(x.Status=="Agendada"&&x.Start<DateTime.Now?"Aguardando registro":x.Status)</span>@if(x.Status=="Concluída"){<small>@x.Attendance</small>}@if(x.Notes!=""){<p class="preserve">@x.Notes</p>}@if(x.Mode=="Online"&&x.OnlineUrl!=""&&x.Status=="Agendada"&&x.Start.AddMinutes(x.Minutes)>DateTime.Now){<a class="btn primary" href="@x.OnlineUrl" target="_blank" rel="noopener">Entrar na aula</a>}</div>
<div class="actions lesson-actions">@if(x.Status=="Agendada"){
@if(x.Start>DateTime.Now){<details><summary>Remarcar</summary><partial name="_LessonForm" model="x" /></details><form action="/portal/salvar?kind=lesson-status" method="post" data-confirm="Cancelar a aula de @x.Start.ToString("dd/MM HH:mm")?">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="Status" type="hidden" value="Cancelada"><button class="btn danger">Cancelar</button></form>}
@if(Model.Role!="Aluno"&&x.Start<=DateTime.Now){<details><summary>Registrar presença / falta</summary><form action="/portal/salvar?kind=lesson-status" method="post" class="form-grid">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="Status" type="hidden" value="Concluída"><label>Presença<select name="Attendance" required><option>Presente</option><option>Falta</option></select></label><button class="btn primary">Concluir aula</button></form></details><form action="/portal/salvar?kind=lesson-status" method="post" data-confirm="Registrar esta aula como cancelada?">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><input name="Status" type="hidden" value="Cancelada"><button class="btn danger">Registrar cancelamento</button></form>}}
</div></article>}</section>}
</div><div class="panel empty" data-no-results @(rows.Count>0?"hidden":"")>@(history?"Nenhuma aula no histórico.":"Nenhuma aula neste período.")</div>
