@model PortalVm
<p class="help">Sistema de registro — sem cobranças online.</p><div class="metrics"><div class="metric violet"><small>Recebido</small><strong>@Model.Payments.Where(x=>x.Paid!=null).Sum(x=>x.Amount).ToString("C")</strong></div><div class="metric blue"><small>Pendente</small><strong>@Model.Payments.Where(x=>x.Paid==null&&x.Due.Date>=DateTime.Today).Sum(x=>x.Amount).ToString("C")</strong></div><div class="metric orange"><small>Atrasado</small><strong>@Model.Payments.Where(x=>x.Paid==null&&x.Due.Date<DateTime.Today).Sum(x=>x.Amount).ToString("C")</strong></div></div><details id="nova-mensalidade" class="panel editor"><summary>＋ Registrar mensalidade</summary><form action="/portal/salvar?kind=payment" method="post" class="form-grid">@Html.AntiForgeryToken()<label>Aluno<select name="StudentId" required><option value="">Selecione...</option>@foreach(var p in Model.Students.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Valor (R$)<input name="Amount" type="number" value="" required min="0.01" step="0.01"></label><label>Vencimento<input name="Due" type="date" value="" required ></label><label>Observação<input name="Notes" type="text" value="" ></label><div class="span2"><button class="btn primary">Salvar</button></div></form></details><partial name="_Filters" model="Model" /><div class="tabs" data-status-tabs><button class="btn primary" type="button" data-status="">Todas</button><button class="btn subtle" type="button" data-status="Pago">Pagas</button><button class="btn subtle" type="button" data-status="Pendente">Pendentes</button><button class="btn subtle" type="button" data-status="Atrasado">Atrasadas</button></div><div class="table-wrap"><table><thead><tr><th>Aluno / responsável</th><th>Valor</th><th>Vencimento</th><th>Pagamento</th><th>Forma</th><th>Situação</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model.Payments){<tr data-record data-student="@x.StudentId" data-status="@PortalVm.PaymentStatus(x)" data-date="@x.Due.ToString("yyyy-MM-dd")"><td>@Model.StudentName(x.StudentId)<small>@Model.Students.FirstOrDefault(s=>s.Id==x.StudentId)?.Guardian</small></td><td>@x.Amount.ToString("C")</td><td>@x.Due.ToString("dd/MM/yyyy")</td><td>@(x.Paid?.ToString("dd/MM/yyyy")??"—")</td><td>@(x.Paid==null?"—":x.Method==""?"Não informada":x.Method)</td><td><span class="badge @(x.Paid!=null?"good":PortalVm.PaymentStatus(x)=="Atrasado"?"bad":"")">@PortalVm.PaymentStatus(x)</span></td><td>@if(x.Paid==null){<details><summary>Registrar pagamento</summary><form action="/portal/salvar?kind=paid" method="post" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><label>Data do pagamento<input name="Paid" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required ></label><label>Forma (opcional)<select name="Method"><option value="">Não informada</option><option value="PIX">PIX</option><option value="Dinheiro">Dinheiro</option><option value="Cartão">Cartão</option><option value="Boleto">Boleto</option><option value="Transferência">Transferência</option></select></label><div class="span2"><button class="btn primary">Confirmar registro</button></div></form></details>}else{<details><summary class="danger">Desfazer pagamento</summary><form action="/portal/salvar?kind=unpay" method="post" class="form-grid">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><p class="span2 help">A mensalidade voltará a ficar em aberto. O registro anterior será preservado no histórico.</p><label class="span2">Motivo da correção<textarea name="Reason" maxlength="500" required></textarea></label><button class="btn danger">Confirmar correção</button></form></details>}
<details><summary>Editar mensalidade</summary><form action="/portal/salvar?kind=payment-edit" method="post" class="form-grid">@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@x.Id"><label>Valor (R$)<input name="Amount" inputmode="decimal" value="@x.Amount.ToString("0.00")" required></label><label>Vencimento<input name="Due" type="date" value="@x.Due.ToString("yyyy-MM-dd")" required></label><label class="span2">Observação<textarea name="Notes" maxlength="1000">@x.Notes</textarea></label><label class="span2">Motivo da alteração<textarea name="Reason" required maxlength="500"></textarea></label><button class="btn primary">Salvar alteração</button></form></details>
@if(x.History!=""){<details><summary>Histórico de alterações</summary><p class="preserve">@x.History</p></details>}</td></tr>}@if(Model.Payments.Count==0){<tr><td colspan="7" class="empty">Nenhum registro encontrado.</td></tr>}</tbody></table></div>
<div class="panel empty" data-no-results hidden>Nenhuma mensalidade para os filtros selecionados.</div>