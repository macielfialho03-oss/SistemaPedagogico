@model PortalVm
@{var student=Model.Students.Single(x=>x.Id==Model.SelectedStudent);var sid=student.Id;var lessons=Model.Lessons.Where(x=>x.StudentId==sid).ToList();}
<a class="btn subtle" href="/portal?section=alunos">← Voltar aos alunos</a>
<section class="panel student-profile"><div class="panel-head"><div class="profile-heading"><span class="avatar large">@PortalVm.Initials(student.Name)</span><div><h2>@student.Name</h2><span class="badge">@student.ServiceType</span><span class="badge @(student.Active?"good":"bad")">@student.Status</span></div></div></div>
<dl class="profile-grid"><div><dt>Nível / turno</dt><dd>@student.Level · @student.Shift</dd></div><div><dt>Nascimento</dt><dd>@(student.BirthDate?.ToString("dd/MM/yyyy")??"Não informado")</dd></div><div><dt>Matérias</dt><dd>@Model.SubjectNames(student.SubjectIds)</dd></div><div><dt>Responsável</dt><dd>@(student.Guardian==""?"Não informado":student.Guardian)<small>@student.GuardianPhone</small></dd></div><div><dt>Contato do aluno</dt><dd>@student.Phone<small>@student.Email</small></dd></div><div><dt>Professores vinculados</dt><dd>@string.Join(", ",Model.Enrollments.Where(x=>x.StudentId==sid).Select(x=>Model.TeacherName(x.TeacherId)))</dd></div></dl></section>
<nav class="tabs" aria-label="Seções da ficha"><a class="btn subtle" href="#ficha-aulas">Aulas</a><a class="btn subtle" href="#ficha-notas">Notas</a><a class="btn subtle" href="#ficha-atividades">Atividades</a><a class="btn subtle" href="#ficha-progresso">Evolução</a>@if(Model.Role=="Admin"){<a class="btn subtle" href="#ficha-mensalidades">Mensalidades</a>}</nav>
<section id="ficha-aulas" class="panel"><h2>Aulas</h2>@foreach(var x in lessons.OrderByDescending(x=>x.Start)){<div class="list-item"><div><strong>@Model.SubjectName(x.SubjectId)</strong><small>@x.Start.ToString("dd/MM/yyyy HH:mm") · @Model.TeacherName(x.TeacherId)</small></div><span class="badge">@(x.Status=="Agendada"&&x.Start<DateTime.Now?"Aguardando registro":x.Status)</span></div>}@if(lessons.Count==0){<p class="empty">Nenhuma aula registrada.</p>}<a href="/portal?section=aulas">Abrir agenda →</a></section>
<section id="ficha-notas" class="panel"><h2>Notas</h2>@foreach(var x in Model.Grades.Where(x=>x.StudentId==sid)){<div class="list-item"><div><strong>@x.Title</strong><small>@Model.SubjectName(x.SubjectId) · @x.Date.ToString("dd/MM/yyyy") · @(x.Source=="Nota da escola"?x.Source:"Avaliação do professor")</small></div><strong>@x.Value.ToString("0.0") / 10</strong></div>}<a href="/portal?section=notas">Abrir avaliações →</a></section>
<section id="ficha-atividades" class="panel"><h2>Atividades e materiais</h2>@foreach(var x in Model.Activities.Where(x=>x.StudentId==sid)){<div class="list-item"><strong>@x.Title</strong><span class="badge">@x.Status</span></div>}@foreach(var x in Model.Materials.Where(x=>x.StudentId==sid)){<div class="list-item"><strong>@x.Title</strong><a href="/portal/arquivo/material/@x.Id">Baixar material</a></div>}<a href="/portal?section=atividades">Abrir atividades →</a></section>
<section id="ficha-progresso" class="panel"><h2>Evolução</h2>@foreach(var x in Model.Progress.Where(x=>x.StudentId==sid)){<div class="list-item"><div><strong>@x.Date.ToString("dd/MM/yyyy") · @Model.SubjectName(x.SubjectId)</strong><p class="preserve">@x.Evolution</p><small>Próximos passos: @x.NextSteps</small></div></div>}<a href="/portal?section=progresso">Abrir histórico →</a></section>
@if(Model.Role=="Admin"){<section id="ficha-mensalidades" class="panel"><h2>Mensalidades</h2>@foreach(var x in Model.Payments.Where(x=>x.StudentId==sid)){<div class="list-item"><strong>@x.Amount.ToString("C")</strong><span>@x.Due.ToString("dd/MM/yyyy")</span><span class="badge @(x.Paid!=null?"good":"")">@PortalVm.PaymentStatus(x)</span></div>}<a href="/portal?section=mensalidades">Abrir mensalidades →</a></section>}
