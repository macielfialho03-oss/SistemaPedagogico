@model PortalVm
@{ ViewData["RegistrationSubjects"] = Model.Subjects; var emptySubjects = ""; }

@if(Model.Role=="Admin"){<details id="cadastro-aluno" class="panel editor"><summary>＋ Cadastrar aluno</summary><form action="/portal/salvar?kind=student" method="post" class="form-grid" data-wizard>@Html.AntiForgeryToken()<div class="span2 wizard-nav" aria-label="Etapas do cadastro"></div><fieldset class="wizard-step span2" data-step-title="Aluno"><div class="form-grid"><label>Nome completo<input name="Name" data-fullname type="text" value="" required maxlength="120"></label><label>Nascimento<input name="BirthDate" type="date" max="@DateTime.Today.AddYears(-4).ToString("yyyy-MM-dd")" value="" ></label><label>E-mail<input name="Email" type="email" value="" ></label><label>Telefone<input name="Phone" type="tel" inputmode="tel" autocomplete="tel-national" data-phone placeholder="(69) 99999-9999" title="Informe o DDD e o número do telefone" value="" ></label></div></fieldset><fieldset class="wizard-step span2" data-step-title="Responsável"><div class="form-grid"><label>Responsável<input name="Guardian" data-fullname maxlength="120"></label><label>Telefone do responsável<input name="GuardianPhone" type="tel" data-phone placeholder="(69) 99999-9999"></label></div><p class="help">Informe quem acompanha a criança e um telefone para contato.</p></fieldset><fieldset class="wizard-step span2" data-step-title="Atendimento"><div class="form-grid"><label>Tipo de atendimento<select name="ServiceType"  required><option>Reforço escolar</option><option>Acompanhamento escolar</option><option>Ambos</option></select></label><label>Nível escolar<select name="Level" required><option value="Pré-escola">Pré-escola</option><option value="Ensino Fundamental I">Ensino Fundamental I</option><option value="Ensino Fundamental II">Ensino Fundamental II</option><option value="Ensino Médio">Ensino Médio</option><option value="Pré-vestibular">Pré-vestibular</option></select></label><label>Turno<select name="Shift" required><option value="Manhã">Manhã</option><option value="Tarde">Tarde</option><option value="Noite">Noite</option></select></label><partial name="_SubjectChoices" model="emptySubjects" /><label>Situação<select name="Status" required><option value="Ativo">Ativo</option><option value="Inativo">Inativo</option><option value="Formado">Formado</option></select></label><label>Professor inicial (opcional)<select name="AssignedTeacherId"><option value="">Vincular depois</option>@foreach(var p in Model.Teachers.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label></div></fieldset><fieldset class="wizard-step span2" data-step-title="Mensalidades"><input type="hidden" name="RegistrationKey" value="@Guid.NewGuid()"><fieldset class="choice-field span2"><legend>Mensalidades do aluno</legend><p class="help">Opcional. As parcelas aparecerão no Controle de Mensalidades após salvar este cadastro.</p><div class="form-grid" data-billing><label>Quantidade de meses<input name="BillingMonths" type="number" min="0" max="60" value="0"></label><label>Valor mensal (R$)<input name="MonthlyAmount" type="number" min="0.01" max="1000000" step="0.01" disabled></label><label>Primeiro vencimento<input name="FirstDue" type="date" disabled></label></div><p class="help" data-billing-preview>Sem geração de mensalidades.</p></fieldset></fieldset><fieldset class="wizard-step span2" data-step-title="Conferir"><h3>Confira a matrícula</h3><dl class="review-grid" data-wizard-review></dl><p class="help">Ao confirmar, o aluno, o vínculo inicial e as mensalidades informadas serão salvos juntos.</p></fieldset><div class="span2 form-actions"><button type="button" class="btn subtle" data-wizard-back>Voltar</button><button type="button" class="btn primary" data-wizard-next>Continuar</button><button class="btn primary" data-wizard-save>Confirmar matrícula</button><button type="button" class="btn subtle" data-close-editor>Cancelar</button></div></form></details>}<div class="table-wrap"><table><thead><tr><th>Aluno</th><th>Nível</th><th>Matérias</th><th>Responsável</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model.Students.Where(x=>x.Name.Contains(Model.Query,StringComparison.OrdinalIgnoreCase))){<tr><td><span class="avatar">@PortalVm.Initials(x.Name)</span> @x.Name<small>@x.ServiceType</small></td><td>@x.Level</td><td>@Model.SubjectNames(x.SubjectIds)</td><td>@x.Guardian<small>@x.GuardianPhone</small></td><td><span class="badge @(x.Active?"good":"bad")">@x.Status</span></td><td class="row-actions"><a class="btn primary" href="/portal?section=ficha&amp;studentId=@x.Id">Ver ficha</a>@if(Model.Role=="Admin"){<details><summary>Editar</summary><partial name="_EditStudent" model="x" /></details><a class="btn subtle" href="/portal?section=usuarios#aluno-@x.Id">Criar acesso</a>
 <details><summary>Mudar situação</summary><form action="/portal/salvar?kind=student-status" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><label>Situação<select name="Status" required><option value="Ativo" selected="@(x.Status=="Ativo")">Ativo</option><option value="Inativo" selected="@(x.Status=="Inativo")">Inativo</option><option value="Formado" selected="@(x.Status=="Formado")">Formado</option></select></label><button class="btn subtle">Salvar situação</button></form></details>
 <details><summary class="danger">Excluir aluno</summary><form action="/portal/salvar?kind=delete-student" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><p class="help">Exclui este cadastro, o acesso do aluno e seus vínculos com professores. Permitido apenas sem histórico.</p><label><input type="checkbox" name="ConfirmDelete" value="true" required> Confirmo excluir @x.Name</label><button class="btn danger">Excluir definitivamente</button></form></details>}</td></tr>}@if(Model.Students.Count==0){<tr><td colspan="6" class="empty">Nenhum cadastro ainda. Use o botão acima para começar.</td></tr>}</tbody></table></div>@if(Model.Role=="Admin"){<details class="panel editor"><summary>Vincular aluno a professor</summary><form action="/portal/salvar?kind=enrollment" method="post" class="form-grid">@Html.AntiForgeryToken()<label>Aluno<select name="StudentId" required><option value="">Selecione...</option>@foreach(var p in Model.Students.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><label>Professor<select name="TeacherId" required><option value="">Selecione...</option>@foreach(var p in Model.Teachers.Where(p=>p.Active)){<option value="@p.Id">@p.Name</option>}</select></label><div class="span2"><button class="btn primary">Salvar</button></div></form></details>}@if(Model.Role=="Admin"){<div class="table-wrap"><table><thead><tr><th>Aluno</th><th>Professor</th></tr></thead><tbody>@foreach(var e in Model.Enrollments){<tr><td>@Model.StudentName(e.StudentId)</td><td>@Model.TeacherName(e.TeacherId)</td></tr>}</tbody></table></div>}