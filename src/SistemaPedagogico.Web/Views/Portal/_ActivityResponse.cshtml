@model Activity
@if(Model.Submitted!=null){<div class="answer"><strong>Entregue em @Model.Submitted.Value.ToString("dd/MM/yyyy HH:mm")</strong>@if(Model.Submitted.Value.Date>Model.Due.Date){<span class="badge bad">Após o prazo</span>}@if(Model.Answer!=""){<p class="preserve">@Model.Answer</p>}@if(Model.FileKey!=null){<a class="btn subtle" href="/portal/arquivo/atividade/@Model.Id">Baixar @Model.FileName</a>@if(new[]{".pdf",".png",".jpg",".jpeg",".txt"}.Contains(System.IO.Path.GetExtension(Model.FileName??"").ToLowerInvariant())){<a class="btn subtle" href="/portal/arquivo/atividade/@Model.Id?preview=true" target="_blank" rel="noopener">Visualizar resposta</a>}}</div>}
@if(Model.Status=="Corrigida"){<section class="answer corrected-answer"><strong>Nota: @(Model.Score?.ToString("0.0")??"—") / 10</strong><p class="preserve">@Model.Feedback</p></section>}
