@model PortalVm
@{ ViewData["RegistrationSubjects"] = Model.Subjects; var emptySubjects = ""; var defaultDays = "1,2,3,4,5"; }

<details id="cadastro-professor" class="panel editor"><summary>＋ Cadastrar professor</summary><form action="/portal/salvar?kind=teacher" method="post" class="form-grid">@Html.AntiForgeryToken()<label>Nome completo<input name="Name" data-fullname type="text" value="" required ></label><label>E-mail<input name="Email" type="email" value="" ></label><label>Telefone<input name="Phone" type="tel" inputmode="tel" autocomplete="tel-national" data-phone placeholder="(69) 99999-9999" title="Informe o DDD e o número do telefone" value="" ></label><partial name="_SubjectChoices" model="emptySubjects" /><partial name="_DayChoices" model="defaultDays" /><label>Disponível a partir de<select name="StartHour" data-current="8" required>@for(var hour=0;hour<=23;hour++){<option value="@hour">@(hour.ToString("00")):00</option>}</select></label><label>Disponível até<select name="EndHour" data-current="18" required>@for(var hour=1;hour<=24;hour++){<option value="@hour">@(hour.ToString("00")):00</option>}</select></label><label>Situação<select name="Active" required><option value="true">Ativo</option><option value="false">Inativo</option></select></label><div class="span2"><button class="btn primary">Cadastrar professor</button></div></form></details><div class="table-wrap"><table><thead><tr><th>Professor</th><th>Matérias</th><th>Disponibilidade</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model.Teachers){<tr><td><span class="avatar">@PortalVm.Initials(x.Name)</span> @x.Name<small>@x.Email</small></td><td>@Model.SubjectNames(x.SubjectIds)</td><td>@string.Join(", ", PortalRules.Ids(x.Days).Select(d => new[] { "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom" }[d-1]))<small>@(x.StartHour.ToString("00")):00 às @(x.EndHour.ToString("00")):00</small></td><td>@(x.Active?"Ativo":"Inativo")</td><td><details><summary>Editar</summary><partial name="_EditTeacher" model="x" /></details><a class="btn subtle" href="/portal?section=usuarios#professor-@x.Id">Criar acesso</a></td></tr>}@if(Model.Teachers.Count==0){<tr><td colspan="5" class="empty">Nenhum cadastro ainda. Use o botão acima para começar.</td></tr>}</tbody></table></div>