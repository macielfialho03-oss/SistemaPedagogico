@model PortalVm
<details id="nova-materia" class="panel editor"><summary>＋ Cadastrar matéria</summary><form action="/portal/salvar?kind=subject" method="post" class="form-grid">@Html.AntiForgeryToken()<label>Nome<input name="Name" type="text" value="" required ></label><label>Descrição<input name="Description" type="text" value="" ></label><label>Situação<select name="Active" required><option value="true">Ativo</option><option value="false">Inativo</option></select></label><div class="span2"><button class="btn primary">Salvar</button></div></form></details><label class="filter-label">Exibir matérias<select data-table-filter><option value="">Todas</option><option value="Ativa">Ativas</option><option value="Inativa">Inativas</option></select></label><div class="table-wrap"><table><thead><tr><th>Matéria</th><th>Descrição</th><th>Alunos</th><th>Situação</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model.Subjects.Where(x=>x.Name.Contains(Model.Query,StringComparison.OrdinalIgnoreCase))){<tr data-status="@(x.Active?"Ativa":"Inativa")"><td>@x.Name</td><td>@x.Description</td><td><small>@Model.Students.Count(a=>PortalRules.Ids(a.SubjectIds).Contains(x.Id)) alunos</small></td><td>@(x.Active?"Ativa":"Inativa")</td><td><details><summary>Editar</summary><partial name="_EditSubject" model="x" /></details><form action="/portal/salvar?kind=subject-status" method="post" data-confirm="@(x.Active?"Desativar esta matéria? O histórico será mantido.":"Ativar esta matéria?")">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><input type="hidden" name="Active" value="@(!x.Active?"true":"false")"><button class="btn subtle">@(x.Active?"Desativar":"Ativar")</button></form></td></tr>}</tbody></table></div>