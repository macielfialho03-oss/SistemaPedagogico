@model Subject
<form action="/portal/salvar?kind=subject" method="post" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id"><label>Nome<input name="Name" type="text" value="@Model.Name" required ></label><label>Descrição<input name="Description" type="text" value="@Model.Description" ></label><label>Situação<select name="Active" data-current="@Model.Active.ToString().ToLowerInvariant()" required><option value="true">Ativo</option><option value="false">Inativo</option></select></label><div class="span2"><button class="btn primary">Salvar</button></div></form>