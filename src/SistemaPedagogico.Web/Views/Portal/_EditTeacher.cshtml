@model Teacher
<form action="/portal/salvar?kind=teacher" method="post" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id"><label>Nome completo<input name="Name" data-fullname type="text" value="@Model.Name" required ></label><label>E-mail<input name="Email" type="email" value="@Model.Email" ></label><label>Telefone<input name="Phone" type="tel" inputmode="tel" autocomplete="tel-national" data-phone placeholder="(69) 99999-9999" title="Informe o DDD e o número do telefone" value="@Model.Phone" ></label><partial name="_SubjectChoices" model="Model.SubjectIds" /><partial name="_DayChoices" model="Model.Days" /><label>Disponível a partir de<select name="StartHour" data-current="@Model.StartHour" required>@for(var hour=0;hour<=23;hour++){<option value="@hour">@(hour.ToString("00")):00</option>}</select></label><label>Disponível até<select name="EndHour" data-current="@Model.EndHour" required>@for(var hour=1;hour<=24;hour++){<option value="@hour">@(hour.ToString("00")):00</option>}</select></label><label>Situação<select name="Active" data-current="@Model.Active.ToString().ToLowerInvariant()" required><option value="true">Ativo</option><option value="false">Inativo</option></select></label><div class="span2"><button class="btn primary">Salvar alterações</button></div></form>