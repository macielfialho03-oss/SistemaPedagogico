@model LoginInput
@{Layout=null;bool setup=ViewBag.Setup==true;}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Entrar · Tutoring</title><link rel="stylesheet" href="~/css/educamais.css" asp-append-version="true"></head><body><div class="login"><section class="login-brand"><a class="brand" href="/conta/entrar"><b>T</b><span>Tutoring<small>Reforço e Acompanhamento Escolar</small></span></a><div><h1>Aprender com suporte<br>faz toda a diferença</h1><p>Gerencie reforço e acompanhamento escolar, acompanhe o desempenho e organize sua jornada educacional em um só lugar.</p><div class="login-features"><span>📅<br>Aulas e horários</span><span>📊<br>Evolução do aluno</span><span>📚<br>Materiais e atividades</span></div></div><small>Tutoring · Reforço e Acompanhamento Escolar</small></section><section class="login-form"><div><h2>@(setup?"Vamos começar?":"Bem-vindo de volta!")</h2><p>@(setup?"Crie sua conta de professora. Você também administrará o sistema.":"Acesse sua conta para continuar")</p>@if(TempData["Success"] is string ok){<div class="notice success">@ok</div>}<div asp-validation-summary="All" class="notice validation"></div><form action="@(setup?"/conta/configurar":"/conta/entrar")" method="post">@Html.AntiForgeryToken()
@if(setup){<label>Nome<input name="Name" required maxlength="120" autocomplete="name"></label>}
<label>E-mail<input name="Email" type="email" required maxlength="150" autocomplete="username" value="@Model.Email" placeholder="seu@email.com"></label><label>Senha<input name="Password" type="password" required minlength="@(setup?10:1)" maxlength="256" autocomplete="@(setup?"new-password":"current-password")"></label>@if(!setup&&ViewBag.Migrate==true){<div class="notice"><strong>Atualização para professora única</strong><p>Entre com a conta de professora ou administradora que deseja manter. Os outros acessos da equipe serão desativados, preservando alunos e históricos. Uma cópia do banco será guardada antes da mudança.</p><label><input type="checkbox" name="AdoptAccount" value="true"> Sou a professora e quero manter esta conta como meu acesso único.</label><small>Alunos: entrem normalmente, sem marcar esta opção.</small></div>}<button class="btn primary wide">@(setup?"Criar minha conta":"Entrar")</button></form><p class="help">@(setup?"Use uma senha com pelo menos 10 caracteres. As contas dos alunos serão criadas em Acessos.":"Esqueceu sua senha? Solicite a redefinição à professora.")</p></div></section></div></body></html>
