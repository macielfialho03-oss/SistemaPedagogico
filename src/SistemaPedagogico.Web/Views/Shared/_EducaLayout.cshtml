@{var role=User.FindFirstValue(ClaimTypes.Role)??"";var section=Context.Request.Query["section"].ToString();if(section=="")section="painel";
var menu=role=="Admin"?new[]{("painel","🏠","Painel"),("alunos","👥","Alunos"),("professores","🎓","Professores"),("aulas","⏰","Horários"),("materias","📚","Matérias"),("mensalidades","💰","Mensalidades"),("usuarios","🔑","Acessos"),("notas","📊","Notas"),("atividades","📝","Atividades"),("materiais","📂","Materiais"),("progresso","📈","Progresso"),("relatorios","▤","Relatórios"),("backup","↻","Backup")}:role=="Professor"?new[]{("painel","🏠","Painel"),("aulas","📅","Minha agenda"),("alunos","👥","Alunos"),("notas","📊","Notas"),("atividades","📝","Atividades"),("materiais","📚","Materiais"),("progresso","📈","Progresso")}:new[]{("painel","🏠","Início"),("aulas","📅","Agenda"),("notas","📊","Notas"),("atividades","📝","Atividades"),("materiais","📚","Materiais"),("progresso","📈","Meu progresso")};}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] · EducaMais</title><link rel="stylesheet" href="~/css/educamais.css" asp-append-version="true"></head><body>
<div class="shell"><aside class="sidebar"><a class="brand" href="/portal"><b>E+</b><span>Educa<strong>Mais</strong></span></a><nav aria-label="Menu principal">@foreach(var item in menu){<a class="nav-item @(section==item.Item1?"selected":"")" href="/portal?section=@item.Item1"><span>@item.Item2</span>@item.Item3</a>}
@if(role=="Admin"){<a class="nav-item legacy" href="/Index">Histórico pedagógico anterior ↗</a>}</nav><div class="identity"><form action="/conta/sair" method="post">@Html.AntiForgeryToken()<button class="logout">🚪 Sair</button></form><div class="person"><span class="avatar">@PortalVm.Initials(User.Identity?.Name??"Usuário")</span><div><strong>@User.Identity?.Name</strong><small>@(role=="Admin"?"Administrador":role)</small></div></div></div></aside>
<main class="main">@if(TempData["Success"] is string ok){<div class="notice success" role="status">@ok</div>}@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error</div>}@RenderBody()<footer>EducaMais · Reforço e acompanhamento escolar · versão 4</footer></main></div><script src="~/js/educamais.js" asp-append-version="true"></script><script src="~/js/phone-inputs.js" asp-append-version="true" defer></script></body></html>
