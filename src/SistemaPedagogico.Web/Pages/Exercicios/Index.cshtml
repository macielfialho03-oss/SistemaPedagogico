@page
@model SistemaPedagogico.Web.Pages.Exercicios.IndexModel
@{ViewData["Title"]="Exercícios";}
<div class="page-heading"><div><span class="eyebrow">REFORÇO ESCOLAR</span><h1>Banco de exercícios</h1><p>Atividades reutilizáveis para as sessões.</p></div></div>
<div class="row g-4"><div class="col-lg-5"><form method="post" class="form-card"><h2 class="h5 mb-3">Novo exercício</h2><div class="mb-3"><label class="form-label">Disciplina</label><select asp-for="Item.DisciplinaId" asp-items="Model.Disciplinas" class="form-select"><option value="">Selecione</option></select></div><div class="mb-3"><label class="form-label">Conteúdo</label><input asp-for="Item.Conteudo" class="form-control"/></div><div class="mb-3"><label class="form-label">Enunciado ou descrição</label><textarea asp-for="Item.Enunciado" class="form-control" rows="4"></textarea></div><div class="row g-3"><div class="col-6"><label class="form-label">Tipo</label><input asp-for="Item.Tipo" class="form-control"/></div><div class="col-6"><label class="form-label">Nível</label><select asp-for="Item.Nivel" class="form-select"><option>Fácil</option><option selected>Médio</option><option>Difícil</option></select></div></div><div class="mt-3"><label class="form-label">Resposta esperada</label><textarea asp-for="Item.RespostaEsperada" class="form-control"></textarea></div><button class="btn btn-primary w-100 mt-3">Salvar exercício</button></form></div><div class="col-lg-7"><section class="panel"><h2 class="h5 mb-3">Exercícios disponíveis</h2>@foreach(var x in Model.Itens){<div class="list-row"><span class="metric-icon blue">✎</span><span class="grow"><strong>@x.Conteudo · @x.Disciplina.Nome</strong><small>@x.Enunciado</small></span><span class="status warning">@x.Nivel</span></div>}@if(Model.Itens.Count==0){<div class="empty-state">Nenhum exercício cadastrado.</div>}</section></div></div>
