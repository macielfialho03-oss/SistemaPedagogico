@page
@using SistemaPedagogico.Core.Entities
@model SistemaPedagogico.Web.Pages.Reforcos.IndexModel
@{ViewData["Title"]="Reforço Escolar";}
<div class="page-heading"><div><span class="eyebrow">REFORÇO ESCOLAR</span><h1>Planos de reforço</h1><p>Transforme dificuldades em objetivos e ações claras.</p></div></div>
<div class="row g-4"><div class="col-lg-5"><form method="post" class="form-card"><h2 class="h5 mb-3">Novo plano</h2><div asp-validation-summary="ModelOnly"></div><div class="mb-3"><label class="form-label">Dificuldade</label><select asp-for="Item.DificuldadeId" asp-items="Model.Dificuldades" class="form-select"><option value="">Selecione</option></select></div><div class="mb-3"><label class="form-label">Título do plano</label><input asp-for="Item.Titulo" class="form-control"/></div><div class="mb-3"><label class="form-label">Objetivo</label><textarea asp-for="Item.Objetivo" class="form-control" rows="3"></textarea></div><div class="mb-3"><label class="form-label">Estratégia</label><textarea asp-for="Item.Estrategia" class="form-control" rows="3"></textarea></div><div class="row g-3"><div class="col-6"><label class="form-label">Início</label><input asp-for="Item.DataInicio" class="form-control"/></div><div class="col-6"><label class="form-label">Previsão</label><input asp-for="Item.DataPrevista" class="form-control"/></div></div><button class="btn btn-primary w-100 mt-3">Criar plano</button></form></div>
<div class="col-lg-7"><section class="panel"><h2 class="h5 mb-3">Planos</h2>@foreach(var x in Model.Itens){<div class="list-row"><span class="metric-icon green">↗</span><span class="grow"><strong>@x.Titulo</strong><small>@x.Aluno.Nome · @x.Disciplina.Nome · @x.Sessoes.Count sessão(ões)</small></span><span class="status @(x.Status==StatusPlanoReforco.Concluido?"success":"warning")">@x.Status</span><a class="btn btn-sm btn-outline-primary" asp-page="/Sessoes/Index" asp-route-planoId="@x.Id">Sessão</a></div>}@if(Model.Itens.Count==0){<div class="empty-state">Nenhum plano de reforço criado.</div>}</section></div></div>
