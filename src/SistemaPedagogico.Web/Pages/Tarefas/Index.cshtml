@page
@using SistemaPedagogico.Core.Entities
@model SistemaPedagogico.Web.Pages.Tarefas.IndexModel
@{ViewData["Title"]="Tarefas";}
<div class="page-heading"><div><span class="eyebrow">ROTINA ESCOLAR</span><h1>Tarefas</h1><p>Organize pendências e prazos escolares.</p></div></div>
<div class="row g-4"><div class="col-lg-4"><form method="post" class="form-card"><h2 class="h5 mb-3">Nova tarefa</h2><div class="mb-3"><label class="form-label">Aluno</label><select asp-for="Item.AlunoId" asp-items="Model.Alunos" class="form-select"><option value="">Selecione</option></select></div><div class="mb-3"><label class="form-label">Disciplina</label><select asp-for="Item.DisciplinaId" asp-items="Model.Disciplinas" class="form-select"><option value="">Geral</option></select></div><div class="mb-3"><label class="form-label">Título</label><input asp-for="Item.Titulo" class="form-control"/></div><div class="mb-3"><label class="form-label">Descrição</label><textarea asp-for="Item.Descricao" class="form-control"></textarea></div><div class="mb-3"><label class="form-label">Prazo</label><input asp-for="Item.Prazo" class="form-control"/></div><button class="btn btn-primary w-100">Adicionar tarefa</button></form></div><div class="col-lg-8"><section class="panel"><h2 class="h5 mb-3">Lista de tarefas</h2>@foreach(var x in Model.Itens){<div class="list-row"><span class="date-chip"><b>@x.Prazo.Day</b><small>@x.Prazo.ToString("MMM")</small></span><span class="grow"><strong>@x.Titulo</strong><small>@x.Aluno.Nome · @(x.Disciplina?.Nome??"Geral")</small></span><span class="status @(x.Status==StatusTarefa.Concluida?"success":"warning")">@x.Status</span>@if(x.Status!=StatusTarefa.Concluida){<form method="post" asp-page-handler="Concluir" asp-route-id="@x.Id"><button class="btn btn-sm btn-outline-primary">Concluir</button></form>}</div>}@if(Model.Itens.Count==0){<div class="empty-state">Nenhuma tarefa cadastrada.</div>}</section></div></div>
