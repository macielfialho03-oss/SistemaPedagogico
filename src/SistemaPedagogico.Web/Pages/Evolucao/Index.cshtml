@page
@model SistemaPedagogico.Web.Pages.Evolucao.IndexModel
@{ViewData["Title"]="Evolução";}
<div class="page-heading"><div><span class="eyebrow">INDICADORES</span><h1>Evolução</h1><p>Resultados escolares e do reforço ao longo do tempo.</p></div></div>
<form method="get" class="action-bar"><select name="alunoId" asp-items="Model.Alunos" class="form-select filter-select"><option value="">Selecione um aluno</option></select><button class="btn btn-primary">Visualizar evolução</button></form>
@if(Model.Aluno is not null){<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card"><span class="metric-icon purple">★</span><div><strong>@Model.MediaNotas%</strong><span>Média de aproveitamento nas notas</span></div></div></div><div class="col-md-4"><div class="metric-card"><span class="metric-icon green">✎</span><div><strong>@Model.MediaExercicios%</strong><span>Média nos exercícios</span></div></div></div><div class="col-md-4"><div class="metric-card"><span class="metric-icon blue">✓</span><div><strong>@Model.Superadas</strong><span>Dificuldades superadas</span></div></div></div></div>
<div class="row g-4"><div class="col-lg-6"><section class="panel"><h2 class="h5">Notas ao longo do tempo</h2>@foreach(var x in Model.Notas){<div class="list-row"><span class="date-chip"><b>@x.Data.Day</b><small>@x.Data.ToString("MMM")</small></span><span class="grow"><strong>@x.Disciplina.Nome · @x.TipoAvaliacao</strong><small>@x.Periodo</small></span><b>@x.Percentual%</b></div>}@if(Model.Notas.Count==0){<div class="empty-state">Sem notas para analisar.</div>}</section></div><div class="col-lg-6"><section class="panel"><h2 class="h5">Sessões de reforço</h2>@foreach(var x in Model.Sessoes){<div class="list-row"><span class="date-chip"><b>@x.DataHora.Day</b><small>@x.DataHora.ToString("MMM")</small></span><span class="grow"><strong>@x.PlanoReforco.Disciplina.Nome</strong><small>@x.ConteudoTrabalhado</small></span><b>@x.Aproveitamento%</b></div>}@if(Model.Sessoes.Count==0){<div class="empty-state">Sem sessões para analisar.</div>}</section></div></div>}
