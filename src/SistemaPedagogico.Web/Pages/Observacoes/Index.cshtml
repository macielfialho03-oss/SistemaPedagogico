@page
@model SistemaPedagogico.Web.Pages.Observacoes.IndexModel
@{ViewData["Title"]="Observações";}
<div class="page-heading"><div><span class="eyebrow">REGISTROS</span><h1>Observações</h1><p>Anotações pedagógicas organizadas por aluno.</p></div></div>
<div class="row g-4"><div class="col-lg-4"><form method="post" class="form-card"><h2 class="h5 mb-3">Nova observação</h2><div class="mb-3"><label class="form-label">Aluno</label><select asp-for="Item.AlunoId" asp-items="Model.Alunos" class="form-select"><option value="">Selecione</option></select></div><div class="mb-3"><label class="form-label">Categoria</label><select asp-for="Item.Categoria" class="form-select"><option>Geral</option><option>Comportamento</option><option>Aprendizagem</option><option>Família</option><option>Saúde</option></select></div><div class="mb-3"><label class="form-label">Data</label><input asp-for="Item.Data" class="form-control"/></div><div class="mb-3"><label class="form-label">Observação</label><textarea asp-for="Item.Texto" class="form-control" rows="5"></textarea></div><div class="form-check mb-3"><input asp-for="Item.Destaque" class="form-check-input"/><label class="form-check-label">Destacar no histórico</label></div><button class="btn btn-primary w-100">Registrar</button></form></div><div class="col-lg-8"><section class="panel"><h2 class="h5 mb-3">Histórico</h2>@foreach(var x in Model.Itens){<div class="list-row"><span class="metric-icon @(x.Destaque?"amber":"purple")">@(x.Destaque?"!":"≡")</span><span class="grow"><strong>@x.Aluno.Nome · @x.Categoria</strong><small>@x.Data.ToString("dd/MM/yyyy") · @x.Texto</small></span></div>}@if(Model.Itens.Count==0){<div class="empty-state">Nenhuma observação registrada.</div>}</section></div></div>
