@page
@model SistemaPedagogico.Web.Pages.Notas.IndexModel
@{ViewData["Title"]="Notas";}
<div class="page-heading"><div><span class="eyebrow">DESEMPENHO</span><h1>Notas</h1><p>Acompanhe avaliações e resultados por disciplina.</p></div></div>
<div class="row g-4"><div class="col-lg-4"><form method="post" class="form-card"><h2 class="h5 mb-3">Registrar nota</h2><div asp-validation-summary="ModelOnly"></div><div class="mb-3"><label class="form-label">Aluno</label><select asp-for="Item.AlunoId" asp-items="Model.Alunos" class="form-select"><option value="">Selecione</option></select></div><div class="mb-3"><label class="form-label">Disciplina</label><select asp-for="Item.DisciplinaId" asp-items="Model.Disciplinas" class="form-select"><option value="">Selecione</option></select></div><div class="row g-3"><div class="col-6"><label class="form-label">Nota</label><input asp-for="Item.Valor" class="form-control"/></div><div class="col-6"><label class="form-label">Valor máximo</label><input asp-for="Item.ValorMaximo" class="form-control"/></div></div><div class="mt-3"><label class="form-label">Período</label><input asp-for="Item.Periodo" class="form-control" placeholder="Ex.: 1º bimestre"/></div><div class="mt-3"><label class="form-label">Tipo</label><input asp-for="Item.TipoAvaliacao" class="form-control"/></div><div class="mt-3"><label class="form-label">Data</label><input asp-for="Item.Data" class="form-control"/></div><button class="btn btn-primary w-100 mt-3">Salvar nota</button></form></div>
<div class="col-lg-8"><div class="table-card table-responsive"><table class="table"><thead><tr><th>Data</th><th>Aluno</th><th>Disciplina</th><th>Avaliação</th><th>Nota</th><th>Aproveitamento</th></tr></thead><tbody>@foreach(var x in Model.Itens){<tr><td>@x.Data.ToString("dd/MM/yy")</td><td>@x.Aluno.Nome</td><td>@x.Disciplina.Nome</td><td>@x.TipoAvaliacao<br/><small>@x.Periodo</small></td><td><b>@x.Valor.ToString("0.##")</b> / @x.ValorMaximo.ToString("0.##")</td><td>@x.Percentual%</td></tr>}@if(Model.Itens.Count==0){<tr><td colspan="6" class="empty-state">Nenhuma nota registrada.</td></tr>}</tbody></table></div></div></div>
