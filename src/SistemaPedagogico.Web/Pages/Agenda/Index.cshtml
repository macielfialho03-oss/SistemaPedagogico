@page
@using SistemaPedagogico.Core.Entities
@model SistemaPedagogico.Web.Pages.Agenda.IndexModel
@{ViewData["Title"]="Agenda";}
<div class="page-heading"><div><span class="eyebrow">ORGANIZAÇÃO</span><h1>Agenda</h1><p>Atendimentos, reuniões e prazos importantes.</p></div></div>
<div class="row g-4"><div class="col-lg-4"><form method="post" class="form-card"><h2 class="h5 mb-3">Novo compromisso</h2><div asp-validation-summary="ModelOnly"></div><div class="mb-3"><label class="form-label">Título</label><input asp-for="Item.Titulo" class="form-control"/></div><div class="mb-3"><label class="form-label">Aluno (opcional)</label><select asp-for="Item.AlunoId" asp-items="Model.Alunos" class="form-select"><option value="">Geral</option></select></div><div class="mb-3"><label class="form-label">Tipo</label><input asp-for="Item.Tipo" class="form-control"/></div><div class="mb-3"><label class="form-label">Início</label><input asp-for="Item.Inicio" class="form-control"/></div><div class="mb-3"><label class="form-label">Término</label><input asp-for="Item.Termino" class="form-control"/></div><div class="mb-3"><label class="form-label">Descrição</label><textarea asp-for="Item.Descricao" class="form-control"></textarea></div><button class="btn btn-primary w-100">Agendar</button></form></div><div class="col-lg-8"><section class="panel"><h2 class="h5 mb-3">Compromissos</h2>@foreach(var x in Model.Itens){<div class="list-row"><span class="date-chip"><b>@x.Inicio.Day</b><small>@x.Inicio.ToString("MMM")</small></span><span class="grow"><strong>@x.Titulo</strong><small>@x.Inicio.ToString("HH:mm") · @(x.Aluno?.Nome??"Geral") · @x.Tipo</small></span><span class="status @(x.Status==StatusAgenda.Realizado?"success":"warning")">@x.Status</span>@if(x.Status==StatusAgenda.Agendado){<form method="post" asp-page-handler="Realizar" asp-route-id="@x.Id"><button class="btn btn-sm btn-outline-primary">Realizado</button></form>}</div>}@if(Model.Itens.Count==0){<div class="empty-state">Agenda livre.</div>}</section></div></div>
