@page
@model SistemaPedagogico.Web.Pages.Disciplinas.IndexModel
@{ViewData["Title"]="Disciplinas";}
<div class="page-heading"><div><span class="eyebrow">CADASTROS</span><h1>Disciplinas</h1><p>Organize conteúdos, notas e reforços por matéria.</p></div></div>
<div class="row g-4"><div class="col-lg-4"><form method="post" class="form-card"><h2 class="h5 mb-3">Nova disciplina</h2><div class="mb-3"><label class="form-label">Nome</label><input asp-for="Item.Nome" class="form-control"/><span asp-validation-for="Item.Nome"></span></div><div class="mb-3"><label class="form-label">Descrição</label><textarea asp-for="Item.Descricao" class="form-control"></textarea></div><div class="mb-3"><label class="form-label">Cor</label><input asp-for="Item.Cor" type="color" class="form-control form-control-color"/></div><button class="btn btn-primary w-100">Cadastrar</button></form></div>
<div class="col-lg-8"><div class="table-card"><table class="table"><thead><tr><th>Disciplina</th><th>Descrição</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var x in Model.Itens){<tr><td><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:@x.Cor;margin-right:8px"></span><b>@x.Nome</b></td><td>@(x.Descricao??"—")</td><td>@(x.Ativa?"Ativa":"Inativa")</td><td><form method="post" asp-page-handler="Alternar" asp-route-id="@x.Id"><button class="btn btn-sm btn-outline-secondary">@(x.Ativa?"Inativar":"Ativar")</button></form></td></tr>}</tbody></table></div></div></div>
