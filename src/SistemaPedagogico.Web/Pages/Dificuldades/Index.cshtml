@page
@using SistemaPedagogico.Core.Entities
@model SistemaPedagogico.Web.Pages.Dificuldades.IndexModel
@{ViewData["Title"]="Dificuldades";}
<div class="page-heading"><div><span class="eyebrow">ACOMPANHAMENTO → REFORÇO</span><h1>Dificuldades</h1><p>Registre necessidades específicas e acompanhe sua superação.</p></div></div>
<div class="row g-4"><div class="col-lg-5"><form method="post" class="form-card"><h2 class="h5 mb-3">Identificar dificuldade</h2><input asp-for="Item.AcompanhamentoOrigemId" type="hidden"/><div class="mb-3"><label class="form-label">Aluno</label><select asp-for="Item.AlunoId" asp-items="Model.Alunos" class="form-select"><option value="">Selecione</option></select></div><div class="mb-3"><label class="form-label">Disciplina</label><select asp-for="Item.DisciplinaId" asp-items="Model.Disciplinas" class="form-select"><option value="">Selecione</option></select></div><div class="mb-3"><label class="form-label">Conteúdo</label><input asp-for="Item.Conteudo" class="form-control" placeholder="Ex.: Frações"/></div><div class="mb-3"><label class="form-label">Descrição</label><textarea asp-for="Item.Descricao" class="form-control" rows="3"></textarea></div><div class="row g-3"><div class="col-6"><label class="form-label">Nível</label><select asp-for="Item.Nivel" class="form-select"><option>Leve</option><option selected>Moderada</option><option>Alta</option></select></div><div class="col-6"><label class="form-label">Identificada em</label><input asp-for="Item.IdentificadaEm" class="form-control"/></div></div><button class="btn btn-primary w-100 mt-3">Registrar dificuldade</button></form></div>
<div class="col-lg-7"><section class="panel"><h2 class="h5 mb-3">Acompanhamento das dificuldades</h2>@foreach(var x in Model.Itens){<div class="list-row"><span class="metric-icon amber">△</span><span class="grow"><strong>@x.Conteudo · @x.Aluno.Nome</strong><small>@x.Disciplina.Nome · @x.Nivel · @x.Descricao</small></span><span class="status @(x.Status==StatusDificuldade.Superada?"success":"warning")">@x.Status</span>@if(x.Status!=StatusDificuldade.Superada){<a class="btn btn-sm btn-outline-primary" asp-page="/Reforcos/Index" asp-route-dificuldadeId="@x.Id">Criar reforço</a><form method="post" asp-page-handler="Superar" asp-route-id="@x.Id"><button class="btn btn-sm btn-outline-success">Superada</button></form>}</div>}@if(Model.Itens.Count==0){<div class="empty-state">Nenhuma dificuldade registrada.</div>}</section></div></div>
