@page "{id:int}"
@using SistemaPedagogico.Core.Entities
@model SistemaPedagogico.Web.Pages.Alunos.DetailsModel
@{ ViewData["Title"] = Model.Item.Nome; }
<div class="profile-hero"><div class="d-flex justify-content-between align-items-start"><div><span class="eyebrow text-white-50">PERFIL DO ALUNO</span><h1 class="mt-2">@Model.Item.Nome</h1><p>@(Model.Item.SerieAno ?? "Série não informada") · @(Model.Item.Escola ?? "Escola não informada") · @(Model.Item.Turno ?? "Turno não informado")</p></div><a class="btn btn-light btn-sm" asp-page="Edit" asp-route-id="@Model.Item.Id">Editar perfil</a></div></div>
<div class="quick-grid mb-4"><a class="quick-card" asp-page="/Acompanhamentos/Index" asp-route-alunoId="@Model.Item.Id"><b>@Model.Item.Acompanhamentos.Count</b><br/><small>Acompanhamentos</small></a><a class="quick-card" asp-page="/Notas/Index" asp-route-alunoId="@Model.Item.Id"><b>@Model.Item.Notas.Count</b><br/><small>Notas</small></a><a class="quick-card" asp-page="/Dificuldades/Index" asp-route-alunoId="@Model.Item.Id"><b>@Model.Item.Dificuldades.Count(x=>x.Status!=StatusDificuldade.Superada)</b><br/><small>Dificuldades abertas</small></a><a class="quick-card" asp-page="/Reforcos/Index" asp-route-alunoId="@Model.Item.Id"><b>@Model.Item.PlanosReforco.Count</b><br/><small>Planos de reforço</small></a></div>
<div class="row g-4"><div class="col-lg-6"><section class="panel"><div class="panel-title"><h2>Responsáveis</h2><a asp-page="/Responsaveis/Index" asp-route-alunoId="@Model.Item.Id">Gerenciar →</a></div>@foreach(var x in Model.Item.Responsaveis){<div class="list-row"><span class="avatar">@x.Responsavel.Nome[..1]</span><span class="grow"><strong>@x.Responsavel.Nome</strong><small>@x.Parentesco · @x.Responsavel.Telefone</small></span></div>}@if(Model.Item.Responsaveis.Count==0){<div class="empty-state">Nenhum responsável vinculado.</div>}</section></div>
<div class="col-lg-6"><section class="panel"><div class="panel-title"><h2>Dificuldades</h2><a asp-page="/Dificuldades/Index" asp-route-alunoId="@Model.Item.Id">Abrir módulo →</a></div>@foreach(var x in Model.Item.Dificuldades.OrderByDescending(x=>x.IdentificadaEm).Take(5)){<div class="list-row"><span class="grow"><strong>@x.Conteudo</strong><small>@x.Disciplina.Nome</small></span><span class="status @(x.Status==StatusDificuldade.Superada?"success":"warning")">@x.Status</span></div>}@if(Model.Item.Dificuldades.Count==0){<div class="empty-state">Nenhuma dificuldade registrada.</div>}</section></div></div>
