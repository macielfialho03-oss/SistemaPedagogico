@page
@model SistemaPedagogico.Web.Pages.Sessoes.IndexModel
@{ViewData["Title"]="Sessões de reforço";}
<div class="page-heading"><div><span class="eyebrow">REFORÇO ESCOLAR</span><h1>Sessões</h1><p>Registre o atendimento e os resultados dos exercícios.</p></div></div>
<div class="row g-4 mb-4"><div class="col-lg-6"><form method="post" class="form-card"><h2 class="h5 mb-3">Nova sessão</h2><div asp-validation-summary="ModelOnly"></div><div class="mb-3"><label class="form-label">Plano de reforço</label><select asp-for="Item.PlanoReforcoId" asp-items="Model.Planos" class="form-select"><option value="">Selecione</option></select></div><div class="row g-3"><div class="col-7"><label class="form-label">Data e hora</label><input asp-for="Item.DataHora" class="form-control"/></div><div class="col-5"><label class="form-label">Duração (min)</label><input asp-for="Item.DuracaoMinutos" class="form-control"/></div></div><div class="mt-3"><label class="form-label">Conteúdo trabalhado</label><textarea asp-for="Item.ConteudoTrabalhado" class="form-control"></textarea></div><div class="mt-3"><label class="form-label">Resumo</label><textarea asp-for="Item.Resumo" class="form-control"></textarea></div><div class="mt-3"><label class="form-label">Próximos passos</label><textarea asp-for="Item.ProximosPassos" class="form-control"></textarea></div><button class="btn btn-primary w-100 mt-3">Registrar sessão</button></form></div>
<div class="col-lg-6"><form method="post" asp-page-handler="Resultado" class="form-card"><h2 class="h5 mb-3">Resultado de exercício</h2><div class="mb-3"><label class="form-label">Sessão</label><select asp-for="Resultado.SessaoReforcoId" asp-items="Model.Sessoes" class="form-select"><option value="">Selecione</option></select></div><div class="mb-3"><label class="form-label">Exercício</label><select asp-for="Resultado.ExercicioId" asp-items="Model.Exercicios" class="form-select"><option value="">Selecione</option></select></div><div class="row g-3"><div class="col-6"><label class="form-label">Acertos</label><input asp-for="Resultado.Acertos" class="form-control"/></div><div class="col-6"><label class="form-label">Erros</label><input asp-for="Resultado.Erros" class="form-control"/></div></div><div class="mt-3"><label class="form-label">Observação</label><textarea asp-for="Resultado.Observacao" class="form-control"></textarea></div><button class="btn btn-outline-primary w-100 mt-3">Registrar resultado</button></form></div></div>
<section class="panel"><h2 class="h5 mb-3">Histórico de sessões</h2>@foreach(var x in Model.Itens){<div class="list-row"><span class="date-chip"><b>@x.DataHora.Day</b><small>@x.DataHora.ToString("MMM")</small></span><span class="grow"><strong>@x.Aluno.Nome · @x.PlanoReforco.Titulo</strong><small>@x.ConteudoTrabalhado · @x.DuracaoMinutos min</small></span><span class="status success">@x.Aproveitamento% aproveitamento</span></div>}@if(Model.Itens.Count==0){<div class="empty-state">Nenhuma sessão registrada.</div>}</section>
