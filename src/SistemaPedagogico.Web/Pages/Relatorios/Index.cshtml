@page
@using SistemaPedagogico.Core.Entities
@model SistemaPedagogico.Web.Pages.Relatorios.IndexModel
@{ViewData["Title"]="Relatórios";}
<div class="page-heading"><div><span class="eyebrow">DOCUMENTAÇÃO</span><h1>Relatório individual</h1><p>Resumo do acompanhamento para consulta ou impressão.</p></div>@if(Model.Aluno is not null){<button class="btn btn-primary" onclick="window.print()">Imprimir relatório</button>}</div>
<form method="get" class="action-bar"><select name="alunoId" asp-items="Model.Alunos" class="form-select filter-select"><option value="">Selecione um aluno</option></select><button class="btn btn-outline-primary">Gerar relatório</button></form>
@if(Model.Aluno is not null){<article class="form-card"><header class="border-bottom pb-3 mb-4"><h2>@Model.Aluno.Nome</h2><p class="text-muted mb-0">@(Model.Aluno.Escola??"Escola não informada") · @(Model.Aluno.SerieAno??"Série não informada") · Relatório emitido em @DateTime.Now.ToString("dd/MM/yyyy")</p></header><h3 class="h5">Responsáveis</h3><p>@(Model.Aluno.Responsaveis.Count==0?"Não informado":string.Join(" · ",Model.Aluno.Responsaveis.Select(x=>$"{x.Responsavel.Nome} ({x.Parentesco})")))</p><h3 class="h5 mt-4">Notas</h3><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Data</th><th>Disciplina</th><th>Avaliação</th><th>Resultado</th></tr></thead><tbody>@foreach(var x in Model.Aluno.Notas.OrderByDescending(x=>x.Data)){<tr><td>@x.Data.ToString("dd/MM/yyyy")</td><td>@x.Disciplina.Nome</td><td>@x.TipoAvaliacao</td><td>@x.Valor/@x.ValorMaximo (@x.Percentual%)</td></tr>}</tbody></table></div><h3 class="h5 mt-4">Dificuldades e situação</h3>@foreach(var x in Model.Aluno.Dificuldades){<p><b>@x.Disciplina.Nome · @x.Conteudo:</b> @x.Descricao — @x.Status</p>}<h3 class="h5 mt-4">Acompanhamentos recentes</h3>@foreach(var x in Model.Aluno.Acompanhamentos.OrderByDescending(x=>x.Data).Take(10)){<p><b>@x.Data.ToString("dd/MM/yyyy") · @x.Tipo:</b> @x.Resumo</p>}<h3 class="h5 mt-4">Observações</h3>@foreach(var x in Model.Aluno.Observacoes.OrderByDescending(x=>x.Data).Take(10)){<p><b>@x.Data.ToString("dd/MM/yyyy") · @x.Categoria:</b> @x.Texto</p>}</article>}
